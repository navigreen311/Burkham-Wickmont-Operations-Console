# Burkham Wickmont Operations Console - environment template
# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# Local development uses the native PostgreSQL 17 service.
DATABASE_URL="postgresql://YOUR_PG_USER:YOUR_PG_PASSWORD@127.0.0.1:5432/bwc_console_dev?schema=public"

# --- Event Ledger ---------------------------------------------------------
# HMAC key used to sign ledger entries. Rotate through a secret manager in any
# deployed environment; a signature is only as meaningful as the key's custody.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEDGER_SIGNING_KEY="YOUR_LEDGER_SIGNING_KEY_HERE"

# --- Secure Document Vault (3.2) ------------------------------------------
# Key-encryption key. Each document gets a random DEK; the DEK is wrapped by this
# KEK. Rotating the KEK re-wraps DEKs rather than re-encrypting every tax return.
# Specification v2 section 6.2 wants this in an HSM before production - the
# EnvKekProvider is a development seam, and KekProvider is where an HSM plugs in.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_KEK="YOUR_VAULT_KEK_HERE"
# Where encrypted blobs land. Ciphertext only - the store never receives plaintext.
VAULT_BLOB_ROOT="./.vault-blobs"

# --- API ------------------------------------------------------------------
API_PORT=4100
NODE_ENV=development

# --- Workflow Engine worker (module 2.2) ---------------------------------
# The worker writes ledger events, and principle 3 allows no anonymous state
# changes - so it acts as a real, resolvable actor rather than a synthetic
# "system" identity. Startup refuses if this does not resolve.
WORKER_ACTOR_ID="YOUR_WORKER_ACTOR_UUID_HERE"
WORKER_INTERVAL_MS=5000
WORKER_BATCH_SIZE=20
# Optional: restrict this worker to one tenant. Omit to process every tenant.
# WORKER_TENANT_ID=

# --- Integration Layer (11.5) --------------------------------------------
# All external calls route through the Integration Layer. Every vendor below is
# gated on Argus security review + signed DPA + SOC 2 Type II before any real
# credential is used (Specification v2 section 11.4). Until that gate clears,
# adapters run in stub mode and report not_built honestly rather than faking data.
INTEGRATION_MODE=stub   # stub | sandbox | live

# Decision A - Plaid is the V1 bank statement source
PLAID_CLIENT_ID="YOUR_PLAID_CLIENT_ID_HERE"
PLAID_SECRET="YOUR_PLAID_SECRET_HERE"
PLAID_ENV=sandbox

# Decision B - business bureau (vendor selection pending: Nav / Experian / D&B)
BUSINESS_BUREAU_API_KEY="YOUR_BUSINESS_BUREAU_API_KEY_HERE"

# Decision B - personal credit (vendor selection pending: Array or equivalent)
PERSONAL_CREDIT_API_KEY="YOUR_PERSONAL_CREDIT_API_KEY_HERE"

# CapitalForge - the Console calls it, never reimplements it
CAPITALFORGE_BASE_URL="http://127.0.0.1:4000"
CAPITALFORGE_API_KEY="YOUR_CAPITALFORGE_API_KEY_HERE"

# Protects the TOTP secrets behind client multi-factor authentication.
# A SEPARATE key from VAULT_KEK: one key for both would mean a compromise of
# either reaches the other, and rotating one would force rotating the other.
#
# 32 bytes of hex. Generate with:  openssl rand -hex 32
# Without it, enrolling a second factor REFUSES - the TOTP secret has to be
# recoverable to compute codes, so storing it unprotected is not an option
# anybody would notice.
MFA_SECRET_KEY=YOUR_MFA_SECRET_KEY_HERE

# --- Internal Console transport (apps/api) -----------------------------------
# The staff-facing surface. Keep it OFF the public load balancer: only the
# Client Portal goes near one - docs/adr/0022-the-portal-is-a-separate-process.md.

CONSOLE_PORT=4100

# The firm this deployment serves. Deployment configuration, never a request
# value - the same rule as PORTAL_TENANT_ID and for the same reason.
CONSOLE_TENANT_ID=YOUR_TENANT_UUID_HERE

# REQUIRED, no default. `true` in any deployment reachable over a network.
CONSOLE_COOKIE_SECURE=false

# REQUIRED, no default. `false`, or the NUMBER of trusted proxies. `true` is
# refused - see PORTAL_TRUST_PROXY above.
CONSOLE_TRUST_PROXY=false

# REQUIRED, no default. `memory` for one instance, `shared` for more than one.
CONSOLE_RATE_LIMIT_STORE=memory

# OFF unless you set it, and REFUSED with NODE_ENV=production.
#
# This is the `x-actor-id` header the internal API ran on before it had a
# sign-in: any caller could act as any actor by naming its id, which is not
# authentication. It survives for the worker, the integration tests and a
# developer with curl. A deployment with this on has no authentication at all
# on its internal surface, which is why the config throws rather than warns.
# CONSOLE_DEV_ACTOR_HEADER=true

# Optional.
# CONSOLE_COOKIE_NAME=bwc_console_session
# CONSOLE_MAX_JSON_BYTES=65536
# CONSOLE_SIGN_IN_WINDOW_SECONDS=300
# CONSOLE_SIGN_IN_MAX_ATTEMPTS=5

# --- Client Portal transport (apps/portal-api) -------------------------------
# Run this as a SEPARATE process from apps/api. Only this one goes near a public
# load balancer - see docs/adr/0022-the-portal-is-a-separate-process.md.

PORTAL_PORT=4200

# The tenant this deployment serves. Deployment configuration, never a request
# value: a client who chooses their tenant is a client enumerating tenants.
PORTAL_TENANT_ID=YOUR_TENANT_UUID_HERE

# REQUIRED, no default. `true` in any deployment reachable over the internet.
# `false` only for local plaintext development.
PORTAL_COOKIE_SECURE=false

# REQUIRED, no default. `false` when nothing is in front of this process, or the
# NUMBER of trusted proxies between the client and here.
#
# `true` is REFUSED: it makes Express trust the whole X-Forwarded-For chain, which
# the client writes, so an attacker rotates the header and per-IP rate limiting
# stops counting anything real.
PORTAL_TRUST_PROXY=false

# REQUIRED, no default. Where attempt counters live.
#   memory  correct for exactly ONE instance. Each process counts on its
#           own, so three replicas give an attacker three times the limit
#           and a rolling deploy hands them a clean slate.
#   shared  the counter lives in Postgres, where every instance sees it.
#
# Neither is the default: both failures are invisible from inside a process.
PORTAL_RATE_LIMIT_STORE=memory

# REQUIRED, no default. The WebAuthn relying party.
#   PORTAL_RP_ID   the DOMAIN a security key's credential is scoped to. No
#                  scheme, no port: 'portal.example.com'.
#   PORTAL_ORIGIN  the exact origin a browser must have been on, scheme and
#                  port included, no path: 'https://portal.example.com'.
#
# Neither may ever come from a request. An RP ID a caller chooses is a caller
# choosing the scope of the credential; an origin a caller chooses is the
# phishing resistance switched off by the party it exists to stop.
PORTAL_RP_ID=localhost
PORTAL_ORIGIN=http://localhost:4200
# PORTAL_RP_NAME=Burkham Wickmont

# Optional.
# PORTAL_MAX_UPLOAD_BYTES=26214400
# PORTAL_SIGN_IN_WINDOW_SECONDS=300
# PORTAL_SIGN_IN_MAX_ATTEMPTS=10

# Password reset counts on its OWN limiter, not sign-in's. One shared bucket
# would let an attacker spraying resets from a shared address lock legitimate
# clients out of signing in.
# PORTAL_RESET_WINDOW_SECONDS=900
# PORTAL_RESET_MAX_ATTEMPTS=5
