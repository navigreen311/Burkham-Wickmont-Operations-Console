{
  "name": "@bwc/worker",
  "version": "0.1.0",
  "private": true,
  "description": "The Workflow Engine worker process. Runs scheduler, listener and engine on an interval.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@bwc/core": "workspace:*",
    "@bwc/db": "workspace:*",
    "@bwc/identity": "workspace:*",
    "@bwc/workflow": "workspace:*",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
