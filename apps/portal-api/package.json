{
  "name": "@bwc/portal-api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP transport for the 11.10 Client Portal. A separate process from the internal API.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@bwc/consent": "workspace:*",
    "@bwc/core": "workspace:*",
    "@bwc/http": "workspace:*",
    "@bwc/identity": "workspace:*",
    "@bwc/portal": "workspace:*",
    "@bwc/vault": "workspace:*",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/express": "^5.0.0"
  }
}
