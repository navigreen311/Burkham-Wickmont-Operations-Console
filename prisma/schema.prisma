// Burkham Wickmont Operations Console - data model
//
// Specification v2 section 5.1: "No service reaches directly into another service's database."
// Each module owns a named Postgres schema. Package boundaries enforce this in code; the
// schema separation enforces it in the database, so a cross-module query is visible as a
// cross-schema reference in review rather than invisible as an ordinary join.
//
// Append-only discipline for the ledger is enforced by a trigger, not by convention -
// see prisma/migrations/*/migration.sql. Prisma cannot express "no UPDATE, no DELETE".

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["tenancy", "identity", "ledger", "clients", "consent", "firewall", "workflow", "notifications", "deliverables", "claims", "vault", "intelligence", "lenders", "governance", "graph", "regulatory", "contracts", "billing", "sales", "evidence", "comms", "risk", "partners", "calls", "marketing", "interventure", "admin", "warehouse", "outcomes", "retention"]
}

// ---------------------------------------------------------------------------
// 11.2 Tenant / Organization Model
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  actors  Actor[]
  clients Client[]

  @@map("tenants")
  @@schema("tenancy")
}

// ---------------------------------------------------------------------------
// 11.1 Identity & Access
// ---------------------------------------------------------------------------

enum ActorKind {
  village_agent
  human

  @@schema("identity")
}

model Actor {
  id       String    @id @default(uuid()) @db.Uuid
  tenantId String    @db.Uuid
  kind     ActorKind
  label    String

  /// Authority Level 0-3. There is no level 4 holder: level 4 is the prohibited-action
  /// list, hard-blocked by middleware for every actor. Specification v2 section 7.1.
  authorityLevel Int
  department     String?
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  credential  ActorCredential?
  sessions    ActorSession[]
  invitations ActorInvitation[]

  @@index([tenantId])
  @@map("actors")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// 11.3 Event Ledger - append-only, hash-chained, signed
// ---------------------------------------------------------------------------

model LedgerEvent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// Monotonic per tenant. Combined with prevHash this makes a gap or a reordering detectable.
  seq Int

  type          String
  actorId       String  @db.Uuid
  actorKind     String
  clientId      String? @db.Uuid
  correlationId String? @db.Uuid

  /// Redacted before write and asserted PII-free. Retained indefinitely, which is exactly
  /// why nothing sensitive may enter it - an append-only store cannot be cleaned up later.
  payload Json

  prevHash  String
  signature String
  createdAt DateTime @default(now())

  @@unique([tenantId, seq])
  @@index([tenantId, clientId])
  @@index([tenantId, type])
  @@map("ledger_events")
  @@schema("ledger")
}

// ---------------------------------------------------------------------------
// 1.1 Client Lifecycle & CRM
// ---------------------------------------------------------------------------

/// Decision E: categorical, never numeric. Declaration order is not a ranking, and no
/// ordering is exposed anywhere in the codebase - see packages/core/src/compliance.ts.
enum ComplianceState {
  pending_assessment
  pass
  pass_with_findings
  needs_review
  fail

  @@schema("clients")
}

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  legalName String

  complianceState ComplianceState @default(pending_assessment)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  findings ComplianceFinding[]

  @@index([tenantId])
  @@map("clients")
  @@schema("clients")
}

model ComplianceFinding {
  id         String    @id @default(uuid()) @db.Uuid
  clientId   String    @db.Uuid
  code       String
  summary    String
  openedAt   DateTime  @default(now())
  resolvedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("compliance_findings")
  @@schema("clients")
}

// ---------------------------------------------------------------------------
// 1.5 Consent & Authorization Center
// ---------------------------------------------------------------------------

/// Per-event, never blanket. Decision A makes plaid_connection GLBA-adjacent and
/// Decision B makes the bureau pulls FCRA-adjacent, so each is authorized individually.
enum ConsentKind {
  application
  business_bureau_pull
  personal_credit_pull
  plaid_connection
  disclosure
  cross_portfolio_handoff
  /// 8.1 Partner & Referrer Portal. Consent to work with us is not consent to be reported on to
  /// the partner who made the introduction; this is the authorization that separates the two.
  partner_status_visibility
  /// 4.3 Call Recording. Required in all-party-consent states, where recording a client without
  /// their consent is a crime in the state where the client is sitting.
  call_recording

  @@schema("consent")
}

model Consent {
  id       String      @id @default(uuid()) @db.Uuid
  tenantId String      @db.Uuid
  clientId String      @db.Uuid
  kind     ConsentKind

  /// What this consent covers - a specific application id, a named institution, a named
  /// recipient for a handoff. A consent without a scope is a blanket consent by accident.
  scope String

  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  @@index([tenantId, clientId, kind])
  @@map("consents")
  @@schema("consent")
}

// ---------------------------------------------------------------------------
// 6.2 Funding Ethics Firewall
// ---------------------------------------------------------------------------

enum FirewallState {
  clear
  triggered

  @@schema("firewall")
}

model ClientFirewallState {
  clientId  String        @id @db.Uuid
  tenantId  String        @db.Uuid
  state     FirewallState @default(clear)
  reason    String?
  updatedAt DateTime      @updatedAt @default(now())

  @@index([tenantId])
  @@map("client_firewall_states")
  @@schema("firewall")
}

// ---------------------------------------------------------------------------
// 2.2 Workflow Engine - Decision C makes the Console the runner for all workflows
// ---------------------------------------------------------------------------

enum PlaybookStatus {
  draft
  review
  active
  retired

  @@schema("workflow")
}

model Playbook {
  id      String         @id @default(uuid()) @db.Uuid
  key     String
  version Int
  phase   Int
  status  PlaybookStatus @default(draft)

  /// The node graph. Validated on publish; see packages/workflow/src/playbook.ts.
  definition Json

  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([key, version])
  @@index([key, status])
  @@map("playbooks")
  @@schema("workflow")
}

enum InstanceStatus {
  running
  waiting
  completed
  failed
  cancelled

  @@schema("workflow")
}

model WorkflowInstance {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String? @db.Uuid

  /// Version is pinned at start. Publishing a new playbook version must not silently
  /// re-route an instance already in flight - it would change the rules mid-engagement.
  playbookKey     String
  playbookVersion Int

  status        InstanceStatus @default(running)
  currentNodeKey String?

  /// Accumulated workflow variables. Read by decision predicates. Must stay PII-free -
  /// it is copied into ledger payloads.
  context Json @default("{}")

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  tasks WorkflowTask[]

  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@map("workflow_instances")
  @@schema("workflow")
}

enum TaskStatus {
  pending
  running
  waiting
  succeeded
  failed
  dead_letter
  cancelled

  @@schema("workflow")
}

enum TaskKind {
  agent_task
  human_checkpoint
  decision
  wait
  terminal

  @@schema("workflow")
}

model WorkflowTask {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @db.Uuid
  instanceId String @db.Uuid
  nodeKey    String

  kind       TaskKind
  status     TaskStatus @default(pending)
  department String?
  priority   Int        @default(0)

  /// When this task becomes eligible to run. A wait state is a row with runAt in the
  /// future - weeks or months is the same code path as seconds.
  runAt DateTime @default(now())

  attempts       Int @default(0)
  maxAttempts    Int @default(3)
  backoffSeconds Int @default(30)

  /// Claim lease. An expired lease means the worker holding it died; the task returns to
  /// pending rather than being lost.
  leaseExpiresAt DateTime?
  lockedBy       String?

  lastError String?
  slaDueAt  DateTime?
  escalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  /// The claim query orders by priority then runAt over pending rows.
  @@index([status, runAt, priority])
  @@index([tenantId, instanceId])
  @@map("workflow_tasks")
  @@schema("workflow")
}

model ScheduledWorkflow {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  key         String
  playbookKey String

  /// Five-field cron, evaluated by cron-parser.
  cronExpression String

  /// IANA zone the cron expression is read in. "Monthly on the 1st at 9am" is meaningless
  /// without one, and defaulting silently to UTC would land every Capital Command Brief at
  /// 1am or 2am Pacific depending on the season.
  timezone String @default("UTC")

  nextRunAt DateTime
  lastRunAt DateTime?
  enabled   Boolean   @default(true)

  createdAt DateTime @default(now())

  @@unique([tenantId, key])
  @@index([enabled, nextRunAt])
  @@map("scheduled_workflows")
  @@schema("workflow")
}

/// Starts a workflow when a matching Event Ledger event is written - the event-listener half
/// of Specification v2 section 5.3.
model WorkflowTrigger {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  eventType   String
  playbookKey String

  /// Optional declarative predicate (the playbook language) evaluated against the event
  /// payload and the client. Null means fire on every event of this type.
  condition Json?

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  firings WorkflowTriggerFiring[]

  @@unique([tenantId, eventType, playbookKey])
  @@index([tenantId, eventType, enabled])
  @@map("workflow_triggers")
  @@schema("workflow")
}

/// Idempotency record: this trigger has already handled this ledger event.
///
/// The unique constraint is the mechanism, not the cursor. A crash between starting an instance
/// and advancing the listener cursor replays the event; the insert conflicts and nothing starts
/// twice. A duplicated workflow here means duplicated client outreach.
model WorkflowTriggerFiring {
  id             String @id @default(uuid()) @db.Uuid
  triggerId      String @db.Uuid
  ledgerEventId  String @db.Uuid
  instanceId     String? @db.Uuid

  firedAt DateTime @default(now())

  trigger WorkflowTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  @@unique([triggerId, ledgerEventId])
  @@map("workflow_trigger_firings")
  @@schema("workflow")
}

/// How far a consumer has read the per-tenant Event Ledger sequence.
model LedgerCursor {
  tenantId String @db.Uuid
  consumer String

  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt @default(now())

  @@id([tenantId, consumer])
  @@map("ledger_cursors")
  @@schema("workflow")
}

// ---------------------------------------------------------------------------
// 11.4 Notification & Task Queue - the substrate the Workflow Engine dispatches through
// ---------------------------------------------------------------------------

enum NotificationStatus {
  open
  acknowledged
  completed
  cancelled

  @@schema("notifications")
}

// ---------------------------------------------------------------------------
// 3.3 Document Intelligence Pipeline
// ---------------------------------------------------------------------------

/// Where normalized data came from. Decisions A and B name the V1 sources.
enum IntelligenceSource {
  plaid
  business_bureau
  personal_credit
  uploaded_document

  @@schema("intelligence")
}

enum IngestionStatus {
  /// Consent present, adapter reached, data normalized.
  completed
  /// The vendor is not activated. Distinct from failing - nothing was attempted.
  not_available
  /// The client has not authorized this specific pull or connection.
  unauthorized
  failed

  @@schema("intelligence")
}

model IngestionRun {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  source IntelligenceSource
  status IngestionStatus

  /// The specific consent that authorized this. Decision A makes a Plaid connection
  /// GLBA-adjacent and Decision B makes bureau pulls FCRA-adjacent; both are per-event.
  consentId String? @db.Uuid

  /// When the vendor produced the data. Every fact derived from this run carries it, so a
  /// figure can always be dated rather than assumed current.
  retrievedAt DateTime?

  /// How much of the requested window actually arrived. A reconciliation over 3 of 24 months
  /// is a different claim from one over all 24, and must not read as the same.
  monthsRequested Int
  monthsCovered   Int @default(0)

  /// Normalized accounts and transactions. Held here rather than in their own table until real
  /// volume justifies the schema - see docs. Never raw vendor payloads.
  normalized Json?

  failureReason String?

  createdAt DateTime @default(now())

  findings IntelligenceFinding[]

  @@index([tenantId, clientId, source])
  @@map("ingestion_runs")
  @@schema("intelligence")
}

/// What downstream modules read. Risk & Defense (6.1) sources its alerts from exactly these.
enum FindingKind {
  nsf_event
  large_deposit
  owner_transfer
  revenue_mismatch
  balance_deterioration
  missing_document
  bureau_bank_disagreement

  @@schema("intelligence")
}

enum FindingSeverity {
  informational
  attention
  urgent

  @@schema("intelligence")
}

model IntelligenceFinding {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid
  runId    String? @db.Uuid

  kind     FindingKind
  severity FindingSeverity

  summary String

  /// Structured detail plus its provenance. Principle 8: a derived figure ships how it was
  /// derived, including the feed timestamp it rests on.
  detail Json

  occurredAt DateTime?
  createdAt  DateTime  @default(now())

  run IngestionRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId, kind])
  @@map("intelligence_findings")
  @@schema("intelligence")
}

// ---------------------------------------------------------------------------
// 3.2 Secure Document Vault - the most sensitive data class in the portfolio
// ---------------------------------------------------------------------------

/// The document kinds blueprint 3.2 names. Drives the minimum Authority Level to read.
enum DocumentKind {
  bank_statement
  tax_return
  government_id
  entity_document
  credit_report
  profit_and_loss
  balance_sheet
  debt_schedule
  lender_application
  signed_authorization
  adverse_action_notice
  other

  @@schema("vault")
}

/// Virus scanning on upload (blueprint 3.2). `pending` is the honest default: no scanner is
/// wired, and a document that has not been scanned must not be readable. Defaulting to `clean`
/// would assert a check that never ran.
enum ScanStatus {
  pending
  clean
  infected
  scan_unavailable

  @@schema("vault")
}

model VaultDocument {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  kind        DocumentKind
  filename    String
  contentType String
  byteSize    Int

  /// Digest of the PLAINTEXT, verified after decryption. Detects a corrupted or swapped blob
  /// even when the ciphertext itself decrypts successfully.
  sha256 String

  /// Where the ciphertext lives in the blob store. Opaque to everything but the store.
  blobKey String @unique

  /// Envelope encryption. The DEK is random per document and stored only in wrapped form; the
  /// KEK never leaves the key provider. Rotating the KEK re-wraps these rather than
  /// re-encrypting every payload.
  wrappedDek String
  iv         String
  authTag    String

  scanStatus ScanStatus @default(pending)
  scannedAt  DateTime?
  scanDetail String?

  /// Retention (blueprint 3.2, gated on 7.2/7.5 for the per-state rules). Null means no schedule
  /// has been resolved yet, which blocks deletion rather than permitting it.
  retainUntil DateTime?

  /// Legal hold overrides retention and blocks export and deletion outright.
  legalHold       Boolean   @default(false)
  legalHoldReason String?
  legalHoldSetAt  DateTime?

  uploadedBy String   @db.Uuid
  createdAt  DateTime @default(now())
  deletedAt  DateTime?

  accessLog VaultAccessLog[]

  @@index([tenantId, clientId])
  @@index([tenantId, kind])
  @@map("vault_documents")
  @@schema("vault")
}

/// Every access. Blueprint 3.2 requires access logs; §10.5 makes cross-tenant leakage a
/// zero-tolerance metric, and a refused attempt is as worth recording as a successful read.
model VaultAccessLog {
  id         String @id @default(uuid()) @db.Uuid
  documentId String @db.Uuid
  tenantId   String @db.Uuid

  actorId   String @db.Uuid
  actorKind String
  action    String
  granted   Boolean
  reason    String?

  /// Whether the bytes handed over carried a watermark. False is recorded rather than implied,
  /// because a non-PDF export cannot be stamped.
  watermarked Boolean @default(false)

  at DateTime @default(now())

  /// Access order, from a Postgres sequence. See `LeadActivity.seq` for the argument.
  ///
  /// The strongest case of the four this column was added to. One request routinely writes several
  /// entries - a read, then an export, or a refusal followed by a second attempt - inside the same
  /// millisecond, and the order of an access log **is** the artifact: "they were refused and then
  /// they got in" and "they got in and were later refused" are different findings, and `at` alone
  /// cannot tell a regulator which one happened.
  seq BigInt @unique @default(autoincrement())

  document VaultDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId, at, seq])
  @@index([tenantId, actorId])
  @@map("vault_access_log")
  @@schema("vault")
}

// ---------------------------------------------------------------------------
// 7.4 Marketing Claim Library - version-controlled approved and banned language
// ---------------------------------------------------------------------------

enum ClaimDisposition {
  approved
  banned
  requires_disclaimer

  @@schema("claims")
}

model MarketingClaim {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// The literal phrase, matched on word boundaries rather than as a substring.
  phrase      String
  disposition ClaimDisposition

  /// Why. Blueprint 7.4 requires "public documentation of ban rationale for internal training" -
  /// a banned phrase without a reason cannot be taught, argued with, or safely revisited.
  rationale String

  /// `*` means every jurisdiction; a state code restricts it to that state.
  ///
  /// A sentinel rather than NULL, deliberately: Postgres treats NULL as distinct from NULL, so a
  /// unique constraint containing a nullable column would permit two "global" entries for the
  /// same phrase - exactly the case this constraint exists to prevent.
  jurisdiction String @default("*")

  /// Disclosure text a requires_disclaimer phrase obliges.
  requiredDisclosure String?

  /// Compliance Review Board approval, per blueprint 7.4's weekly cadence.
  approvedBy String
  version    Int     @default(1)
  active     Boolean @default(true)

  createdAt    DateTime  @default(now())
  deprecatedAt DateTime?

  @@unique([tenantId, phrase, jurisdiction])
  @@index([tenantId, disposition, active])
  @@map("marketing_claims")
  @@schema("claims")
}

// ---------------------------------------------------------------------------
// 3.1 Document & Deliverable Management / 3.4 Deliverable Approval Workflow
// ---------------------------------------------------------------------------

/// draft -> qa_checked -> scanned -> awaiting_human -> approved -> delivered
/// with blocked and rejected as terminal off-ramps. Ordering is enforced by this
/// state, not by the order a caller happens to invoke things in.
enum DeliverableStatus {
  draft
  qa_checked
  scanned
  blocked
  awaiting_human
  approved
  rejected
  delivered

  @@schema("deliverables")
}

model DeliverableTemplate {
  id      String @id @default(uuid()) @db.Uuid
  key     String
  version Int

  title       String
  description String

  /// True when a human must review before delivery regardless of scan result -
  /// anything carrying funding recommendations or compliance state.
  requiresHumanReview Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([key, version])
  @@map("deliverable_templates")
  @@schema("deliverables")
}

model Deliverable {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  templateKey     String
  templateVersion Int

  /// Monotonic per (client, template). A regenerated deliverable is a new version, never an
  /// edit - the previous one may already have been sent.
  version Int

  status DeliverableStatus @default(draft)

  /// The structured content document. This, not the rendered bytes, is the audit artifact.
  content Json

  /// sha256 over the canonical JSON of `content`. Answers "was this what we sent?" without
  /// retaining the rendering. A font substitution or library upgrade changes the bytes and must
  /// not change the evidence.
  contentHash String

  scanResult Json?
  scannedAt  DateTime?

  reviewedBy String?
  reviewedAt DateTime?
  rejectionReason String?

  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, templateKey, version])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@map("deliverables")
  @@schema("deliverables")
}

model TaskNotification {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// Which workflow task produced this, when one did. Null for notifications raised
  /// outside a workflow.
  workflowTaskId String? @db.Uuid
  clientId       String? @db.Uuid

  /// Department or human queue this is assigned to.
  assignedTo String
  kind       String
  summary    String

  status   NotificationStatus @default(open)
  slaDueAt DateTime?

  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  completedAt    DateTime?

  @@index([tenantId, assignedTo, status])
  @@index([tenantId, workflowTaskId])
  @@map("task_notifications")
  @@schema("notifications")
}

// ---------------------------------------------------------------------------
// 5.2 Lender Intelligence Database
//
// The structured intelligence layer on every provider. Blueprint 5.2 calls it a
// "defensible long-term asset", and what makes it defensible is not the list of
// lenders - anyone can compile that - but the provenance on every rule. Decision D
// applied portfolio-wide: a velocity rule read off the issuer's published terms and
// one somebody assumed are stored differently, so they can never be presented alike.
// ---------------------------------------------------------------------------

enum ProviderKind {
  card_issuer
  national_bank
  fintech_loc
  credit_union
  mca_provider
  factor
  equipment_lessor
  sba_lender

  @@schema("lenders")
}

enum ProductKind {
  business_credit_card
  line_of_credit
  term_loan
  merchant_cash_advance
  invoice_factoring
  equipment_finance
  sba_loan

  @@schema("lenders")
}

/// How a stored rule was arrived at. Mirrors `Provenance` in @bwc/core; stored as
/// discrete columns rather than JSON so that "which rules are unresearched" is a
/// query a compliance officer can run rather than a scan of every row.
enum ProvenanceTag {
  issuer_rule
  unresearched_default
  vendor_feed

  @@schema("lenders")
}

model Provider {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  name String
  kind ProviderKind

  /// State codes served. `*` means nationwide - a sentinel rather than an empty array,
  /// because an empty array reads identically to "nobody has filled this in yet".
  statesServed String[]

  /// Broker and referral rules. Blueprint 5.2 tracks these because whether we may be
  /// compensated, and how it must be disclosed, differs per provider and is the kind of
  /// thing that changes without notice.
  brokerRulesSummary String?

  /// Disclosures this provider obliges on any communication that names it.
  disclosureRequirements String[]

  /// Free-text risks a human recorded. Deliberately not an enum: the useful ones are the
  /// ones nobody anticipated.
  knownRisks String[]

  /// What happens at renewal - the behaviour that determines whether a facility is a
  /// building block or a cliff.
  renewalBehavior String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules     LenderRule[]
  offerings ProductOffering[]
  contacts  ProviderContact[]
  appetite  AppetiteSignal[]
  outcomes  LenderOutcome[]

  @@unique([tenantId, name])
  @@index([tenantId, kind, active])
  @@map("providers")
  @@schema("lenders")
}

/// A single researched fact about a provider - a velocity rule, an inquiry tolerance, a
/// seasoning requirement.
///
/// Superseded rather than overwritten. A rule that was current in March has to remain
/// explicable when it justifies a March recommendation, and the specification requires
/// every rule change logged with its source and verification method.
model LenderRule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  /// Stable identifier for what the rule is about, e.g. `velocity.cards_per_6_months`.
  ruleKey String
  /// The rule's content, as text. Rules are heterogeneous - a count, a duration, a
  /// prohibition - and a typed column per shape would fit none of them.
  ruleValue String

  version Int @default(1)

  /// Provenance, per Decision D. Not nullable: an untagged rule is a rejected write.
  provenanceTag ProvenanceTag

  /// Populated for `issuer_rule`.
  sourceUrl    String?
  lastVerified DateTime?
  verifiedBy   String?

  /// Populated for `unresearched_default` - why the assumption is a reasonable one to hold.
  rationale String?

  /// Populated for `vendor_feed`.
  vendor      String?
  retrievedAt DateTime?

  supersededAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([providerId, ruleKey, version])
  @@index([tenantId, providerId, supersededAt])
  @@index([tenantId, provenanceTag])
  @@map("lender_rules")
  @@schema("lenders")
}

/// A product a provider offers, and the underwriting box it applies.
///
/// The box is what makes eligibility computable rather than a matter of an agent's
/// recollection.
model ProductOffering {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  name        String
  productKind ProductKind

  minAmount Decimal @db.Decimal(14, 2)
  maxAmount Decimal @db.Decimal(14, 2)

  /// The underwriting box. Null means the provider publishes no threshold on this
  /// dimension - which is not the same as a threshold of zero, and must not be stored as one.
  minTimeInBusinessMonths Int?
  minAnnualRevenue        Decimal? @db.Decimal(14, 2)
  minPersonalCreditScore  Int?

  /// Industries this offering will not fund. Blueprint 5.2's "industries accepted / excluded".
  excludedIndustries String[]

  repaymentStructure String
  feeModel           String

  /// Indicative pricing. Mutually exclusive by product type - a factor rate is not a rate,
  /// and 5.6 exists because the two get confused.
  typicalAnnualRate Decimal? @db.Decimal(8, 6)
  typicalFactorRate Decimal? @db.Decimal(6, 4)

  /// Provenance on the offering's terms, same discipline as LenderRule.
  provenanceTag ProvenanceTag
  sourceUrl     String?
  lastVerified  DateTime?
  verifiedBy    String?
  rationale     String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, name])
  @@index([tenantId, productKind, active])
  @@map("product_offerings")
  @@schema("lenders")
}

enum AppetiteSignalValue {
  expanding
  steady
  tightening
  paused

  @@schema("lenders")
}

/// Blueprint 5.2: "weekly appetite signal updates from Village agents."
///
/// Append-only by construction - each observation is a new row, so appetite has a history
/// and a reader can see a provider tightening over three weeks rather than only that it is
/// tight today.
model AppetiteSignal {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  signal     AppetiteSignalValue
  note       String
  /// Who or what observed it. A signal without an observer cannot be weighed.
  observedBy String
  observedAt DateTime

  createdAt DateTime @default(now())

  @@index([tenantId, providerId, observedAt])
  @@map("appetite_signals")
  @@schema("lenders")
}

enum PlacementOutcome {
  approved
  declined
  withdrawn
  funded
  failed_to_fund

  @@schema("lenders")
}

/// Win/loss records, for approval-rate tracking by lender x client profile.
///
/// A minimal stand-in for 5.5 Funding Outcome Ledger (V1.5), which will subsume it. Kept
/// here because blueprint 5.2 owns "historical approval-rate tracking" and a rate needs
/// observations to be a rate at all.
model LenderOutcome {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  productKind ProductKind

  /// Coarse bucket of the applicant, e.g. `revenue:250k-1m|tib:24-60|fico:700-749`. Coarse
  /// on purpose: a finer key gives every client their own cohort of one, and a cohort of one
  /// produces rates of 0% or 100%.
  clientProfileKey String

  outcome   PlacementOutcome
  decidedAt DateTime

  createdAt DateTime @default(now())

  @@index([tenantId, providerId, productKind])
  @@index([tenantId, clientProfileKey])
  @@map("lender_outcomes")
  @@schema("lenders")
}

/// Contact directory. Business contacts at the provider, not client PII.
model ProviderContact {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  name  String
  role  String
  email String?
  phone String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, providerId])
  @@map("provider_contacts")
  @@schema("lenders")
}

enum ResearchStatus {
  not_started
  in_progress
  blocked
  complete

  @@schema("lenders")
}

/// The V1.5 credit-union research workstream, per Decision D.
///
/// A research row is NOT a Provider. It has no offerings and no governance record, so no
/// recommendation query can reach it - which is how "restricted to Navy Federal in V1"
/// survives contact with an eager agent. The five deferred credit unions live here until
/// their research completes and someone deliberately promotes them.
model ResearchWorkstream {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  providerName String
  kind         ProviderKind

  status               ResearchStatus @default(not_started)
  assignedTo           String?
  targetCompletionDate DateTime?
  notes                String?

  /// Set when research completes AND a provider record is created from it. Until then the
  /// workstream is knowledge, not a placement option.
  promotedProviderId String?   @db.Uuid
  promotedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, providerName])
  @@index([tenantId, status])
  @@map("research_workstreams")
  @@schema("lenders")
}

// ---------------------------------------------------------------------------
// 5.4 Capital Product Governance Board
//
// Governance status deliberately lives in its own schema rather than as a column on
// Provider. A `status` field on the provider would let the module that DESCRIBES
// providers also decide which are usable, which is the separation 5.4 exists to create.
// Separated, a provider the board has never seen has no governance row at all - and
// absence resolves to "not approved", so the safe default is structural rather than a
// default value somebody can edit.
// ---------------------------------------------------------------------------

enum GovernanceStatus {
  pending_review
  approved
  under_review
  suspended
  blacklisted

  @@schema("governance")
}

model ProviderGovernance {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// One governance record per provider. Cross-schema by id rather than by relation:
  /// specification 5.1 - no service reaches into another service's database.
  providerId String @db.Uuid

  status GovernanceStatus @default(pending_review)

  lastReviewedAt DateTime?
  /// Blueprint 5.4: "quarterly minimum". Stored per provider because a higher-risk
  /// provider can be put on a shorter cycle; it can never be lengthened past the minimum.
  reviewCadenceDays Int @default(90)

  /// State restrictions, propagated to the Regulatory Engine. An empty approvedStates means
  /// no restriction beyond what the provider itself serves.
  approvedStates   String[]
  restrictedStates String[]

  requiredDisclosures  String[]
  referralAgreementRef String?
  reputationRiskNotes  String?

  /// Complaints crossing the threshold auto-flag for review. The count is a running total
  /// within the current window; the window resets on review.
  complaintCount       Int       @default(0)
  complaintWindowStart DateTime?

  /// Populated only when status is blacklisted. A blacklist without a stated reason cannot
  /// be appealed, taught, or revisited when the provider fixes the problem.
  blacklistReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, providerId])
  @@index([tenantId, status])
  @@map("provider_governance")
  @@schema("governance")
}

/// Audit trail on every decision - blueprint 5.4, and the record a regulator asks for when
/// the question is "who decided this provider was acceptable, and on what basis".
///
/// Insert-only in practice: nothing in the package updates or deletes these rows.
model GovernanceDecision {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  providerId String @db.Uuid

  fromStatus GovernanceStatus?
  toStatus   GovernanceStatus

  /// Why. Required, for the same reason a banned marketing phrase needs one: a decision
  /// nobody can explain calcifies into folklore.
  rationale String
  decidedBy String
  decidedAt DateTime @default(now())

  @@index([tenantId, providerId, decidedAt])
  @@map("governance_decisions")
  @@schema("governance")
}

enum ComplaintSeverity {
  low
  moderate
  severe

  @@schema("governance")
}

model ProviderComplaint {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  providerId String @db.Uuid

  /// Where it came from - a client, a partner, a regulator bulletin, a public database.
  source   String
  summary  String
  severity ComplaintSeverity

  receivedAt DateTime
  createdAt  DateTime @default(now())

  @@index([tenantId, providerId, receivedAt])
  @@map("provider_complaints")
  @@schema("governance")
}

// ---------------------------------------------------------------------------
// 1.2 Client Household / Entity Graph
//
// The blueprint's worked example of what goes wrong without this: a client signs a
// personal guarantee on a facility for their operating company, a second for the
// real-estate entity that leases them their premises, and a third for a partner's
// DBA. Each was reasonable alone. Nobody holds the total - including the client -
// and the first lender to ask "what else do you guarantee?" gets a wrong answer.
//
// One edge table with a `kind` discriminant rather than a table per relationship
// type: the traversals are kind-agnostic, and five tables would make every walk a
// five-way union. The type safety a table-per-kind would give is recovered by a
// validity table in code (model.ts), which is itself tested.
// ---------------------------------------------------------------------------

enum EntityRole {
  operating
  holding
  real_estate
  dba
  trust
  other

  @@schema("graph")
}

model Entity {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  legalName String
  role      EntityRole

  /// Two-letter state code. Drives lender state coverage in 5.3.
  stateOfFormation String?
  /// Time in business is derived from this, never stored - a stored figure is wrong
  /// the day after it is written.
  formationDate    DateTime?
  industry         String?

  /// EIN, envelope-encrypted. The plaintext exists only inside a decrypt call.
  einCiphertext String?
  /// Display only. Enough to confirm which EIN is on file without holding it.
  einLast4      String?

  /// What the client told us, with who said it and when. Surfaces as `client_stated`
  /// provenance - neither a vendor feed nor our assumption.
  statedAnnualRevenue Decimal?  @db.Decimal(14, 2)
  statedRevenueBy     String?
  statedRevenueAt     DateTime?
  /// A document backing the statement, where one exists.
  statedRevenueDocRef String?

  /// The entity a funding application is actually for. At most one per client;
  /// `setPrimaryEntity` clears the others in the same transaction.
  isPrimary Boolean @default(false)

  notes  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, clientId, legalName])
  @@index([tenantId, clientId, isPrimary])
  @@map("entities")
  @@schema("graph")
}

/// An individual with an ownership or guarantor relationship.
///
/// Deliberately thin. The graph needs to know who someone is and what they are on the
/// hook for; it does not need their date of birth, address or contact details, and a
/// field that exists will eventually be populated.
model Owner {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  fullName String

  /// SSN, envelope-encrypted, same discipline as the EIN above.
  ssnCiphertext String?
  ssnLast4      String?

  notes  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, clientId, fullName])
  @@index([tenantId, clientId])
  @@map("owners")
  @@schema("graph")
}

enum EdgeKind {
  /// owner -> entity, with a percentage.
  ownership
  /// entity -> entity. A holding company controlling an operating company.
  control
  /// owner -> entity, or owner -> external facility. The exposure that gets forgotten.
  guarantee
  /// entity -> entity. One company guaranteeing another's obligations.
  cross_guarantee
  /// entity -> external. An outstanding obligation to a named counterparty.
  debt
  /// entity -> entity. Money moving between related companies.
  intercompany_transfer

  @@schema("graph")
}

enum NodeKind {
  owner
  entity
  /// A counterparty outside the graph - a lender, a landlord. Named, not linked.
  external

  @@schema("graph")
}

model GraphEdge {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  kind EdgeKind

  fromKind NodeKind
  fromId   String   @db.Uuid

  toKind NodeKind
  /// Null when `toKind` is external; `toLabel` names the counterparty instead.
  toId    String? @db.Uuid
  toLabel String?

  /// 0-100. Present on ownership and optionally on control.
  ownershipPercent Decimal? @db.Decimal(6, 3)

  /// Debt outstanding, or the amount of an intercompany transfer.
  amount Decimal? @db.Decimal(14, 2)

  /// Cap on a guarantee. NULL means unlimited, which is a materially different
  /// condition rather than a very large cap: unlimited exposure grows with draws the
  /// guarantor has not yet made.
  guaranteeLimit Decimal? @db.Decimal(14, 2)

  /// Where we learned this. A relationship the client declared and one inferred from a
  /// bank feed carry different weight in a conversation with them.
  provenanceTag String
  sourceNote    String?

  effectiveFrom DateTime?
  /// Ended rather than deleted: a guarantee released in March still explains a March
  /// exposure figure.
  endedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, clientId, kind])
  @@index([tenantId, clientId, fromId])
  @@index([tenantId, clientId, toId])
  @@map("graph_edges")
  @@schema("graph")
}

// ---------------------------------------------------------------------------
// 7.2 State-by-State Regulatory Engine
//
// Specification: "The Regulatory Engine is not a post-hoc check. No client-facing
// action fires without state compliance checks having passed. State activation
// itself is gated."
//
// The gate is the module. Everything else here is a lookup table, and the gate is
// what makes the table trustworthy: a state with no activation row is not active,
// so the safe answer is the structural default rather than a value someone edits.
// ---------------------------------------------------------------------------

/// Whether a published version changed what the rules SAY or only how they read.
///
/// Required on every publish rather than defaulted. A default would be chosen once,
/// by whoever wrote the call site, and then inherited by every later change - which
/// is exactly how a material change ships as editorial.
enum StateChangeKind {
  material
  editorial

  @@schema("regulatory")
}

/// A versioned body of rules for one state.
///
/// Superseded rather than overwritten, like lender rules: a module that was current
/// in March has to remain explicable when it justified a March disclosure.
model StateModule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// Two-letter state code.
  state   String
  version Int

  /// What this module covers, in a sentence counsel can read before the detail.
  summary String

  /// The statutes and regimes this module is built on. Not decoration: a disclosure
  /// requirement with no cited basis cannot be reviewed by counsel or defended later.
  citations String[]

  changeKind StateChangeKind
  /// Required when `changeKind` is editorial - what makes this change not material.
  changeRationale String?

  /// Marketing-claim rules scoped to this state, read by the Communication Compliance
  /// Scanner (4.2) alongside the national library.
  marketingNotes String?

  supersededAt DateTime?
  createdAt    DateTime  @default(now())
  createdBy    String

  disclosures StateDisclosure[]

  /// At most one. A state says one thing about referral fees at a time; two rows would be two
  /// answers to a question that has to have one.
  referralFeeRule StateReferralFeeRule?

  @@unique([tenantId, state, version])
  @@index([tenantId, state, supersededAt])
  @@map("state_modules")
  @@schema("regulatory")
}

/// A disclosure a state requires, for a product or for everything.
model StateDisclosure {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  moduleId String      @db.Uuid
  module   StateModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  /// The product this applies to. `*` means every product in the state - a sentinel
  /// rather than NULL, because NULL is distinct from NULL in a unique constraint and
  /// would permit two "all products" rows for the same disclosure.
  productKind String @default("*")

  /// A stable identifier, so the same requirement can be tracked across versions.
  key String
  /// The text itself, or the substance of what must be disclosed.
  text String
  /// Which law obliges it.
  citation String

  createdAt DateTime @default(now())

  @@unique([moduleId, key, productKind])
  @@index([tenantId, productKind])
  @@map("state_disclosures")
  @@schema("regulatory")
}

/// What a state permits by way of paying somebody for an introduction.
///
/// Categorical. There is no "how restricted" number, because the question a payout asks is
/// "may we pay this at all", and a scale would invite a threshold.
enum ReferralFeePosture {
  /// The state permits a referral fee on these facts with no conditions we must carry.
  permitted
  /// Permitted, but only if every condition on the rule holds.
  permitted_with_conditions
  /// Not payable in this state, on any terms.
  prohibited

  @@schema("regulatory")
}

/// A state's restriction on paying a referral fee - blueprint 8.2's "state restrictions on
/// referral fees", owned HERE because 7.2 owns state rules.
///
/// Hangs off the module VERSION rather than off the state, so it is part of what counsel
/// reviewed. Republishing a module materially leaves the new version with no rule attached,
/// and 8.2 refuses rather than carrying the old one forward - see ADR-0053.
model StateReferralFeeRule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  moduleId String      @db.Uuid
  module   StateModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  posture ReferralFeePosture

  /// What must hold before a fee may be paid. Carried to the payout line as evidence, so the
  /// figure travels with the conditions somebody undertook to meet.
  conditions String[]

  /// Cap on the partner's share, in basis points of the fee WE earned. Null means the state
  /// states no cap - which is not the same as "no cap applies", because the agreement's own
  /// share still governs.
  maxShareBasisPoints Int?

  /// The statute or regime. A restriction with no cited basis cannot be reviewed or defended.
  citation String

  createdAt DateTime @default(now())
  createdBy String   @db.Uuid

  @@unique([moduleId])
  @@index([tenantId])
  @@map("state_referral_fee_rules")
  @@schema("regulatory")
}

/// A recorded counsel review. The thing without which no state may activate.
///
/// Insert-only in practice: nothing in the package updates or deletes these rows,
/// because "counsel reviewed version 3" stops being true if version 3 changes.
model CounselReview {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  state         String
  moduleVersion Int

  /// The human who performed or commissioned the review. Not an agent - `activateState`
  /// refuses any actor that is not a Level 3 human.
  reviewedBy String
  reviewedAt DateTime

  /// Where the review lives - a memo, an engagement letter, a file reference. Required:
  /// a review nobody can produce is indistinguishable from one that never happened.
  documentReference String

  /// What counsel concluded, in their words.
  notes String?

  createdAt DateTime @default(now())

  @@index([tenantId, state, moduleVersion])
  @@map("counsel_reviews")
  @@schema("regulatory")
}

/// One row per state that has ever been activated.
///
/// Deliberately NOT a status column. It records which module version was reviewed and
/// when; whether the state is active *now* is derived by comparing that against the
/// current module version. A stored flag and a newer module version drift, and the
/// stored one is the one that would silently be wrong - the same reasoning as
/// governance standing in 5.4 (ADR-0007).
model StateActivation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  state String

  /// The module version counsel reviewed and this activation covers.
  activatedModuleVersion Int
  activatedBy            String
  activatedAt            DateTime

  counselReviewId String @db.Uuid

  /// Set when a state is deliberately withdrawn - not when a module supersedes it.
  withdrawnAt     DateTime?
  withdrawnBy     String?
  withdrawnReason String?

  @@unique([tenantId, state])
  @@map("state_activations")
  @@schema("regulatory")
}

/// The state-law change tracker - blueprint 7.2.
///
/// Records that something changed in a state's law, whether or not a module has caught
/// up. An entry with no resulting module version is the useful case: it is the backlog.
model StateLawChange {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  state   String
  summary String
  /// The statute, bulletin or enforcement action.
  citation  String
  noticedAt DateTime
  noticedBy String

  effectiveOn DateTime?

  /// The module version that incorporated this change, once one does.
  addressedInVersion Int?
  addressedAt        DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, state, addressedAt])
  @@map("state_law_changes")
  @@schema("regulatory")
}

// ---------------------------------------------------------------------------
// 7.3 Contract & Disclosure Builder
//
// The documents a client signs. Two properties shape every table here.
//
// A GENERATED CONTRACT IS FROZEN. Blueprint 7.3 lists "auto-updates when
// Regulatory Engine flags rule changes", and the careless reading of that
// sentence is the most dangerous thing in this module: a document a client
// signed must never change afterwards. What updates is what is generated NEXT,
// and a derived staleness report over what was already issued.
//
// TEMPLATE REVIEW MIRRORS 7.2 rather than sharing its code. Two similar things
// are not yet a pattern - see docs/m7-3-contract-disclosure-builder.md for the
// trigger to extract.
// ---------------------------------------------------------------------------

enum ContractKind {
  service_agreement
  fee_exhibit
  application_authorization
  bureau_pull_authorization
  plaid_connection_authorization
  refund_policy
  partner_disclosure
  product_disclosure

  @@schema("contracts")
}

enum TemplateChangeKind {
  material
  editorial

  @@schema("contracts")
}

model ContractTemplate {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// Stable identifier across versions.
  key     String
  version Int
  kind    ContractKind

  title String

  /// Ordered sections, each a heading and body. The structure is the artifact; rendering to
  /// PDF belongs to 3.1 and a font substitution must not change the evidence.
  sections Json

  changeKind TemplateChangeKind
  /// Required when editorial - what makes this change not material.
  changeRationale String?

  supersededAt DateTime?
  createdAt    DateTime  @default(now())
  createdBy    String

  @@unique([tenantId, key, version])
  @@index([tenantId, key, supersededAt])
  @@map("contract_templates")
  @@schema("contracts")
}

/// The counsel review that permits a template version to generate.
///
/// Keyed on (key, version) rather than on the template row id: the review is of the WORDS at a
/// version, and pointing at a row would let a row edit silently carry a review forward.
model TemplateReview {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  templateKey     String
  templateVersion Int

  reviewedBy String
  reviewedAt DateTime
  /// Where the review lives. Required, for the same reason as a state's counsel review: a review
  /// nobody can produce is indistinguishable from one that never happened.
  documentReference String
  notes             String?

  createdAt DateTime @default(now())

  @@unique([tenantId, templateKey, templateVersion])
  @@map("template_reviews")
  @@schema("contracts")
}

/// A clause that may be inserted, scoped by jurisdiction, offer tier and channel.
///
/// Versioned and superseded rather than edited: a clause that was in force in March has to remain
/// readable when it explains a March agreement.
model Clause {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  key     String
  version Int

  text String
  /// Why this clause exists - a statute, a policy decision, a partner agreement.
  citation String

  /// `*` for every jurisdiction, or a two-letter state code. A sentinel rather than NULL: NULL is
  /// distinct from NULL in a unique constraint and would permit two "global" clauses of one key.
  jurisdiction String @default("*")

  /// Empty means every tier / every channel. Restricting to none would be expressed by not
  /// publishing the clause at all.
  appliesToTiers    String[]
  appliesToChannels String[]

  supersededAt DateTime?
  createdAt    DateTime  @default(now())
  createdBy    String

  @@unique([tenantId, key, jurisdiction, version])
  @@index([tenantId, jurisdiction, supersededAt])
  @@map("clauses")
  @@schema("contracts")
}

/// A document that was issued. Immutable by intent: nothing in the package updates one.
///
/// It pins every input that produced it - template version, state module version, the clause and
/// disclosure keys inserted - so "what exactly did they sign, and on what basis" is answerable
/// years later without reconstructing the world as it was.
model GeneratedContract {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  kind ContractKind

  templateKey     String
  templateVersion Int

  /// The jurisdiction it was generated for, and the Regulatory Engine module version in force at
  /// the time. The pair is what makes staleness computable later.
  state              String
  stateModuleVersion Int

  offerTier String?
  channel   String?

  /// The content model. This, not a rendering, is the artifact - ADR-0005 applied to a document
  /// that creates legal obligations rather than one that merely informs.
  content Json
  /// sha256 over the canonical JSON of `content`.
  contentHash String

  /// What was inserted, so an auditor can see the composition without parsing the content.
  clauseKeys     String[]
  disclosureKeys String[]

  generatedBy String
  issuedAt    DateTime

  createdAt DateTime @default(now())

  @@index([tenantId, clientId, kind])
  @@index([tenantId, state, stateModuleVersion])
  @@map("generated_contracts")
  @@schema("contracts")
}

// ---------------------------------------------------------------------------
// 1.4 Pricing, Billing & Offer Management
//
// Every amount here is stored as an INTEGER NUMBER OF CENTS, not as a decimal or
// a float. See packages/billing/src/money.ts for the three concrete failures that
// motivates - the shortest one being that `paid - earned` in floating point can
// produce a refund of -0.001, and a negative refund is nonsense.
//
// Entitlement to a refund is DERIVED from these records rather than stored. A
// RefundRecord says what was done about an entitlement, not that one exists.
// ---------------------------------------------------------------------------

/// A rung on the five-offer ladder. Versioned: what a client agreed to must remain
/// readable after the offer is repriced.
model OfferDefinition {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  key     String
  version Int

  name        String
  /// Position on the ladder, 1 being the entry rung. Drives upgrade credit.
  rung        Int
  description String

  /// All amounts in cents.
  retainerCents        Int
  monthlyCents         Int    @default(0)
  /// Basis points, so 8.5% is 850 exactly. A percentage as a float is a rate nobody agreed.
  successFeeBasisPoints Int   @default(0)
  /// The engagement minimum, tracked and reported rather than silently enforced.
  minimumCents         Int    @default(0)

  /// Months the engagement commits to, for prepay proration and the quality window.
  committedMonths Int @default(0)

  supersededAt DateTime?
  createdAt    DateTime  @default(now())
  createdBy    String

  engagements Engagement[]

  @@unique([tenantId, key, version])
  @@index([tenantId, key, supersededAt])
  @@map("offer_definitions")
  @@schema("billing")
}

enum EngagementStatus {
  active
  completed
  cancelled

  @@schema("billing")
}

/// A client on a rung, at a specific offer version.
model Engagement {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  offerId String          @db.Uuid
  offer   OfferDefinition @relation(fields: [offerId], references: [id])

  status EngagementStatus @default(active)

  startedOn DateTime
  /// The end of the committed window. Prepay proration and the quality window run against it.
  committedThrough DateTime?

  /// True when the client paid the whole term up front. Deferred revenue: a cancellation part way
  /// through owes back what was paid for and not received.
  annualPrepay Boolean @default(false)

  cancelledOn     DateTime?
  cancelledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records BillingRecord[]

  @@index([tenantId, clientId, status])
  @@map("engagements")
  @@schema("billing")
}

enum BillingRecordKind {
  /// What we said the client owes.
  charge
  /// What the client actually paid.
  payment
  /// Money returned. Paired with a RefundRecord that explains why.
  refund
  /// Value carried forward from an earlier engagement.
  credit_applied

  @@schema("billing")
}

model BillingRecord {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  engagementId String     @db.Uuid
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  kind BillingRecordKind

  /// Cents. Charges and payments are positive; the sign is carried by `kind`, not by the number,
  /// so a query summing amounts cannot silently net a refund against a charge.
  amountCents Int

  description String
  /// For a success fee: the approved credit limit it was computed from. NEVER the requested one -
  /// blueprint 1.4, the Seek Capital lesson. Null for every other kind of line.
  approvedCreditLimitCents Int?

  occurredOn DateTime

  createdAt DateTime @default(now())
  createdBy String

  creditsDrawn CreditApplication[] @relation("SourceRecord")

  @@index([tenantId, engagementId, kind])
  @@map("billing_records")
  @@schema("billing")
}

/// Credit carried from a payment on one engagement onto a later one.
///
/// References the SOURCE billing record rather than an engagement total, so the available balance
/// is derived from what that specific payment has not yet been drawn against. A credit chain that
/// worked off totals could draw the same payment twice through two different upgrades.
model CreditApplication {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// The payment being drawn against.
  sourceRecordId String        @db.Uuid
  sourceRecord   BillingRecord @relation("SourceRecord", fields: [sourceRecordId], references: [id], onDelete: Cascade)

  /// The engagement receiving the credit.
  toEngagementId String @db.Uuid

  amountCents Int
  rationale   String

  appliedOn DateTime
  appliedBy String

  createdAt DateTime @default(now())

  @@index([tenantId, sourceRecordId])
  @@index([tenantId, toEngagementId])
  @@map("credit_applications")
  @@schema("billing")
}

enum RefundDisposition {
  paid
  /// An entitlement somebody decided not to honour. Needs a Level 3 human and a reason.
  declined

  @@schema("billing")
}

/// What was DONE about an entitlement. Not a record that one exists - that is derived.
model RefundRecord {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  engagementId String @db.Uuid

  /// Which objective trigger entitled the client.
  trigger String

  amountCents Int
  disposition RefundDisposition

  /// Required when declined. Declining a refund the record says is owed is the decision that
  /// needs oversight; granting one does not, because it was already owed.
  declineReason String?

  decidedBy String
  decidedAt DateTime

  createdAt DateTime @default(now())

  @@index([tenantId, engagementId])
  @@map("refund_records")
  @@schema("billing")
}

/// A funding outcome, to the extent 1.4 needs one: the 60-day approved-but-unfunded trigger has
/// to know when capital was approved and whether it funded.
///
/// A minimal stand-in for 5.5 Funding Outcome Ledger (V1.5), which will subsume it - the same
/// arrangement 5.2's LenderOutcome has.
model FundingOutcome {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  engagementId String @db.Uuid
  clientId     String @db.Uuid

  provider String

  /// The Seek Capital field distinction, carried into billing. A success fee computes from the
  /// approved figure and there is no column here for what was requested.
  approvedCreditLimitCents Int
  approvedOn               DateTime

  fundedOn    DateTime?
  fundedCents Int?

  createdAt DateTime @default(now())

  @@index([tenantId, engagementId])
  @@map("funding_outcomes")
  @@schema("billing")
}

// ---------------------------------------------------------------------------
// 1.3 Sales Motion & Engagement Tracking
//
// Attribution has money attached to it - a referral fee is owed to whoever
// introduced a client - which makes it a financial fact. A financial fact that
// can be edited after the money is at stake is not a record; it is an opinion
// with a timestamp. So the attribution columns are written once at creation and
// there is no update path in the package. A correction is a separate row with
// the original left intact.
// ---------------------------------------------------------------------------

enum LeadStage {
  new_lead
  qualified
  blueprint_delivered
  review_call_scheduled
  converted
  closed_lost

  @@schema("sales")
}

enum QualificationStatus {
  unqualified
  qualified
  disqualified

  @@schema("sales")
}

/// Why a lead closed without converting.
///
/// Categorical rather than free text, because "why do we lose leads" is a question somebody will
/// want counted, and a thousand sentences cannot be counted. Free-text detail sits alongside.
enum LostReason {
  price
  timing
  not_a_fit
  went_elsewhere
  unresponsive
  compliance_concern
  client_withdrew
  other

  @@schema("sales")
}

model Lead {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// The prospective client's name. Not a Client record yet - a lead is pre-client, which is
  /// exactly why the compliance state does not exist for it.
  prospectName String
  contactName  String?
  contactEmail String?

  stage         LeadStage           @default(new_lead)
  qualification QualificationStatus @default(unqualified)
  /// Why they were qualified or disqualified. A qualification nobody can explain is a filter
  /// nobody can improve.
  qualificationNote String?

  // --- Attribution. Written at creation; no update path exists in the package. -------------
  /// Where the lead came from - a channel, a campaign, a referrer's name.
  sourceChannel String
  /// The partner or referrer, when there is one. First touch, not last: whoever caused the lead
  /// to exist is who the referral relationship is with.
  referrerName String?
  /// The 8.1 Partner record behind that name, when the referrer is an onboarded partner. Written
  /// once with the rest of the attribution group and moved only through `correctAttribution` -
  /// a typed identity for a field that already existed, not a second attribution record.
  referrerPartnerId String? @db.Uuid
  /// Free-form campaign or context, recorded once for the same reason.
  sourceDetail String?
  attributedAt DateTime

  // --- Readiness Blueprint -----------------------------------------------------------------
  blueprintDeliveredOn DateTime?
  /// The readiness figure at delivery. Stored so an expansion trigger can compare against a
  /// later one; the components live in the activity trail rather than being flattened here.
  blueprintReadiness Int?

  reviewCallScheduledFor DateTime?

  /// Drives the 45-day inactivity escalation. Updated by `recordActivity`, never by hand.
  lastActivityAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities  LeadActivity[]
  corrections AttributionCorrection[]
  outcome     LeadOutcome?

  @@index([tenantId, stage])
  @@index([tenantId, lastActivityAt])
  @@index([tenantId, referrerPartnerId])
  @@map("leads")
  @@schema("sales")
}

/// Append-only trail. Nothing updates or deletes one.
model LeadActivity {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  leadId String @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  kind        String
  summary     String
  /// Set when the activity moved the lead between stages, so the trail explains the pipeline
  /// rather than merely accompanying it.
  fromStage LeadStage?
  toStage   LeadStage?

  occurredAt DateTime
  recordedBy String

  createdAt DateTime @default(now())

  /// Insertion order, from a Postgres sequence. **The tie-break `createdAt` cannot be.**
  ///
  /// `occurredAt` is `timestamp(3)`. Two activities written in the same millisecond tie, and the
  /// `{ id: 'asc' }` tie-break behind it is a random UUID - stable for a given set of rows and
  /// unrelated to the order they arrived in. A pipeline trail is read as a sequence, so the
  /// tie-break has to carry the meaning the reader is relying on. ADR-0034 named this and did not
  /// fix it; ADR-0040 fixes it.
  ///
  /// Assignment order, not commit order: two concurrent transactions can take 5 and 6 and commit in
  /// the other order. That is invisible to every reader here, all of which read settled rows. It
  /// would matter to a change feed paginating on `seq > lastSeen`, and there is none.
  seq BigInt @unique @default(autoincrement())

  @@index([tenantId, leadId, occurredAt, seq])
  @@map("lead_activities")
  @@schema("sales")
}

/// A correction to attribution, with the original left untouched on the Lead.
///
/// The question that has to stay answerable is "who was this attributed to when the fee was
/// calculated", and overwriting the original destroys the only evidence of it.
model AttributionCorrection {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  leadId String @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromReferrerName String?
  toReferrerName   String?
  /// The 8.1 Partner ids on each side, when the referrer is an onboarded partner. Carried with
  /// the name so a correction moves both together - a correction that moved only the name would
  /// leave the referral showing in the old partner's portal.
  fromReferrerPartnerId String? @db.Uuid
  toReferrerPartnerId   String? @db.Uuid
  fromSourceChannel String
  toSourceChannel   String

  /// Required. A correction to a financial fact needs a reason somebody signed.
  reason      String
  correctedBy String
  correctedAt DateTime

  createdAt DateTime @default(now())

  @@index([tenantId, leadId])
  @@index([tenantId, toReferrerPartnerId])
  @@map("attribution_corrections")
  @@schema("sales")
}

/// How a lead ended. One per lead - a lead converts once or is lost once.
model LeadOutcome {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  leadId String @unique @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  converted Boolean

  /// Set on conversion. The client record the lead became.
  clientId String? @db.Uuid
  /// The engagement started from it, when one was.
  engagementId String? @db.Uuid

  /// Set when lost. Categorical, so losses can be counted.
  lostReason LostReason?
  lostDetail String?

  decidedBy String
  decidedAt DateTime

  createdAt DateTime @default(now())

  @@index([tenantId, converted])
  @@map("lead_outcomes")
  @@schema("sales")
}

/// A readiness reading taken after the Blueprint.
///
/// Its own table rather than a column on Lead: an expansion trigger compares readings across
/// time, and a single "latest" column would make the comparison a comparison with itself the
/// moment anybody overwrote it.
model ReadinessReading {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  leadId String @db.Uuid

  /// 0-100, the same scale as the Blueprint figure so the two are comparable.
  readiness Int
  /// What moved, in the words the expansion trigger will quote. A delta with no explanation
  /// tells an operator to act without telling them what to say.
  note String

  takenOn DateTime
  takenBy String

  createdAt DateTime @default(now())

  @@index([tenantId, leadId, takenOn])
  @@map("readiness_readings")
  @@schema("sales")
}

enum RenewalStatus {
  not_due
  approaching
  at_risk
  renewed
  lapsed

  @@schema("sales")
}

// ---------------------------------------------------------------------------
// 7.1 Compliance Evidence Vault
//
// This module owns ALMOST NOTHING. Blueprint 7.1's data model names authorizations,
// documents, approval logs, complaints, refunds and state transitions - every one of
// which another module already owns. A table copying them here would produce a second
// version of every fact, drifting from the first, and the copy is the one a regulator
// would be shown.
//
// So there is one table: the record that an export happened. An export is itself an
// event with legal significance - who took a copy of a client's file, when, and why -
// and that fact exists nowhere else.
// ---------------------------------------------------------------------------

enum EvidenceScope {
  client
  engagement

  @@schema("evidence")
}

model EvidenceExport {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  scope    EvidenceScope
  clientId String  @db.Uuid
  /// Set when the scope is an engagement.
  engagementId String? @db.Uuid

  /// Why the file was produced. Required: "who took a copy of this client's file and why" is
  /// the question this table exists to answer, and an export with no stated purpose answers
  /// only half of it.
  purpose     String
  requestedBy String

  /// sha256 over the canonical JSON of the assembled file - ADR-0005 again. Lets a file
  /// produced months ago be checked against what the system would produce now.
  contentHash String

  /// The coverage map at the time of export: which sources were consulted, and what each
  /// returned. Stored rather than recomputed, because coverage AT THE TIME is the fact a
  /// reader needs - what is not built today may be built tomorrow, and the file that went out
  /// said what it said.
  coverage Json

  exportedAt DateTime

  createdAt DateTime @default(now())

  @@index([tenantId, clientId, exportedAt])
  @@map("evidence_exports")
  @@schema("evidence")
}

// ---------------------------------------------------------------------------
// 4.1 Communications Hub, with 4.4 Client Notification Preference Center
//
// The two are one slice because the preference record is the GATE, not a
// convenience. Taking permission as a parameter would let a caller assert consent
// the client never gave, which is the failure TCPA exists about.
//
// Two kinds of "no" live here and are deliberately not the same field: a
// PREFERENCE (I would rather have email) can be overridden by urgency, and a
// PROHIBITION (do not call me; not after 9pm) cannot be overridden by anything.
// ---------------------------------------------------------------------------

enum CommsChannel {
  email
  sms
  voice

  @@schema("comms")
}

enum CommsDirection {
  outbound
  inbound

  @@schema("comms")
}

enum CommsStatus {
  /// Cleared every gate and handed to the provider seam.
  approved_to_send
  /// A gate refused it. `blockedReason` says which.
  blocked
  /// Recorded as received.
  received

  @@schema("comms")
}

/// 4.4 Client Notification Preference Center - one row per client.
model NotificationPreference {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  /// Per-channel permission. Absent permission is NOT permission: these default to false, so a
  /// client who has said nothing is contactable on nothing until somebody records that they are.
  emailAllowed Boolean @default(false)
  smsAllowed   Boolean @default(false)
  voiceAllowed Boolean @default(false)

  /// IANA zone, e.g. `America/Chicago`. Quiet hours are computed in it, and its absence is a
  /// refusal rather than a default - defaulting would send at the wrong hour for exactly the
  /// clients furthest away, invisibly.
  timezone String?

  preferredChannel CommsChannel?

  /// A standing instruction with legal force. No urgency flag reaches past it.
  doNotCall       Boolean   @default(false)
  doNotCallSetOn  DateTime?
  doNotCallReason String?

  /// Where an urgent alert goes when the preferred channel is unavailable.
  urgentRouting String?

  updatedBy String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([tenantId, clientId])
  @@map("notification_preferences")
  @@schema("comms")
}

/// A versioned message template. Superseded rather than edited: a message sent in March has to
/// remain explicable when somebody asks what the client was told.
model MessageTemplate {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  key     String
  version Int
  channel CommsChannel

  /// Empty for SMS and voice.
  subject String?
  body    String

  supersededAt DateTime?
  createdAt    DateTime  @default(now())
  createdBy    String

  @@unique([tenantId, key, version])
  @@index([tenantId, key, supersededAt])
  @@map("message_templates")
  @@schema("comms")
}

/// The communication log - blueprint 4.1's "full client comms log preserved for compliance audit".
///
/// BLOCKED messages are logged too. "We tried to contact this client and could not" is evidence,
/// and a log holding only what went out would answer a regulator's question with the half that
/// flatters us.
model Communication {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  direction CommsDirection
  channel   CommsChannel
  status    CommsStatus

  templateKey     String?
  templateVersion Int?

  subject String?
  /// The message itself. This table is the audit record, so it holds the body - the Ledger does
  /// not, and carries a hash instead.
  body String
  /// sha256 over the body, so the Ledger can identify a message without quoting it.
  bodyHash String

  /// Set when a gate refused it. Names which gate and why.
  blockedReason String?

  /// Set when urgency rerouted the message away from the preferred channel.
  urgentReroute Boolean @default(false)

  occurredAt DateTime
  recordedBy String

  createdAt DateTime @default(now())

  @@index([tenantId, clientId, occurredAt])
  @@index([tenantId, status])
  @@map("communications")
  @@schema("comms")
}


// ---------------------------------------------------------------------------
// 6.4 Do Not Fund Governance, 6.5 Risk Event Timeline
// ---------------------------------------------------------------------------

enum DoNotFundStatus {
  listed
  removed

  @@schema("risk")
}

/// How a client came to be listed. `compliance_fail` is written by the system per Decision E;
/// every other trigger is a human's decision and carries their justification.
enum DoNotFundTrigger {
  compliance_fail
  fraud_indicator
  material_misrepresentation
  repeated_default
  regulatory_action
  client_conduct
  other

  @@schema("risk")
}

model DoNotFundListing {
  id       String          @id @default(uuid()) @db.Uuid
  tenantId String          @db.Uuid
  clientId String          @db.Uuid
  status   DoNotFundStatus @default(listed)
  trigger  DoNotFundTrigger

  /// Why, in the words of whoever decided. Required on every listing, including automatic ones.
  justification String

  /// Set when the system listed the client rather than a person. The reviewing human is still
  /// required to remove it - an automatic listing is not a lesser listing.
  automatic Boolean @default(false)

  listedAt DateTime @default(now())

  /// Null on an automatic listing. No human decided it, and naming one would be a fiction the
  /// audit trail cannot distinguish from a real approval - see autoListForComplianceFail.
  listedBy String? @db.Uuid

  /// Review cadence in days. Overdue flags for review and KEEPS BLOCKING - see listings.ts.
  reviewCadenceDays Int      @default(90)
  lastReviewedAt    DateTime?
  lastReviewedBy    String?  @db.Uuid

  removedAt            DateTime?
  removedBy            String?   @db.Uuid
  removalJustification String?

  createdAt DateTime @default(now())

  overrides DoNotFundOverride[]

  @@index([tenantId, clientId, status])
  @@map("do_not_fund_listings")
  @@schema("risk")
}

/// A scoped, single-use exception. It permits ONE named action and leaves the listing in force.
/// Delisting is a separate act with its own justification - see the plan for why they are not
/// the same decision.
model DoNotFundOverride {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  listingId String           @db.Uuid
  listing   DoNotFundListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// The single action this permits, e.g. `placement_request`. Compared exactly.
  action String

  justification String
  approvedBy    String   @db.Uuid
  approvedAt    DateTime @default(now())

  /// Set when the override is spent. An override is consumed by use, not by time.
  consumedAt DateTime?

  @@index([tenantId, listingId, consumedAt])
  @@map("do_not_fund_overrides")
  @@schema("risk")
}

/// A risk fact that no other module produces yet - a fraud alert phoned in, an NSF report read
/// off a statement, a human intervention. Recorded so the timeline is not silent about facts the
/// company knows; NOT a general event store, which is the Ledger's job.
model RiskObservation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  kind     String
  severity String
  summary  String

  /// Where this came from, in the observer's words. A risk fact with no provenance is a rumour.
  source     String
  occurredAt DateTime
  recordedAt DateTime @default(now())
  recordedBy String   @db.Uuid

  /// Observation order, from a Postgres sequence. See `LeadActivity.seq` for the argument.
  ///
  /// 6.5 calls itself a *chronological* timeline and 6.3 writes into it in bursts - one detection
  /// pass records several observations for one client, all stamped with the same `occurredAt`
  /// because they describe one moment. Without this column that timeline reorders itself on every
  /// read, which is the one thing a timeline must not do.
  seq BigInt @unique @default(autoincrement())

  @@index([tenantId, clientId, occurredAt, seq])
  @@map("risk_observations")
  @@schema("risk")
}

/// The three tiers - blueprint 6.1. Categorical and ordered by seriousness, never numeric:
/// there is no "risk score", and `worstOf` takes the worst tier rather than an average.
enum AlertTier {
  yellow
  orange
  red

  @@schema("risk")
}

enum AlertState {
  /// Raised and nobody has looked.
  open
  /// A human has seen it. NOT resolved - acknowledging is not fixing.
  acknowledged
  resolved

  @@schema("risk")
}

/// A three-tier risk alert on a client - blueprint 6.1.
///
/// `summary` is written by the detector and is asserted PII-free, like every other risk row: it
/// says what kind of thing happened, not who or what account.
///
/// There is no expiry column, deliberately. An alert nobody reviewed is not less true for having
/// aged - see ADR-0055.
model RiskAlert {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  tier  AlertTier
  state AlertState @default(open)

  /// Which detector raised it, and on what. A risk fact with no provenance is a rumour.
  source  String
  summary String

  detectedAt DateTime

  acknowledgedBy String?   @db.Uuid
  acknowledgedAt DateTime?

  resolvedBy String?   @db.Uuid
  resolvedAt DateTime?
  /// Required to resolve. "It stopped mattering" is a decision somebody makes, not one time makes.
  resolutionNote String?

  createdAt DateTime @default(now())

  /// Alert order, from a Postgres sequence, for the same reason the timeline has one.
  seq BigInt @unique @default(autoincrement())

  @@index([tenantId, clientId, state, tier])
  @@map("risk_alerts")
  @@schema("risk")
}

// ---------------------------------------------------------------------------
// 11.9 Cost & Performance Governance
// ---------------------------------------------------------------------------

/// Where a cost came from. Named per Decisions A and B, so a vendor cost is attributable to the
/// decision that introduced it.
enum CostSource {
  model_api
  voice_minutes
  document_processing
  plaid
  business_bureau
  personal_credit

  @@schema("admin")
}

/// How we know this figure - principle 8, applied to money we spend.
///
/// There is no `estimated`. A cost we guessed and a cost we were billed must not be summable, and
/// the moment they share a column somebody sums them. See ADR-0057.
enum CostProvenance {
  /// Counted by us at the time of the call - tokens, minutes, pages.
  observed
  /// Taken from a vendor invoice or statement.
  vendor_invoice

  @@schema("admin")
}

/// One unit of spend - blueprint 11.9.
///
/// `clientId` is nullable and that is the whole difficulty of the module: platform costs are real
/// and are not attributable to a client. A per-client unit cost computed by spreading them evenly
/// would be an allocation presented as a measurement.
model CostRecord {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  clientId String? @db.Uuid

  /// The agent whose action incurred it, where one did.
  actorId String? @db.Uuid

  source     CostSource
  provenance CostProvenance

  /// Integer cents, like all money here (ADR-0011).
  amountCents Int

  /// How many of whatever this source counts - tokens, minutes, pages, pulls. Null when the
  /// vendor bills a subscription rather than a unit.
  units    Int?
  unitKind String?

  /// The model or vendor product, for regression detection across versions.
  vendorRef String?

  occurredOn DateTime

  createdAt DateTime @default(now())
  createdBy String   @db.Uuid

  @@index([tenantId, occurredOn])
  @@index([tenantId, clientId, occurredOn])
  @@index([tenantId, source, occurredOn])
  @@map("cost_records")
  @@schema("admin")
}

// ---------------------------------------------------------------------------
// 10.2 Cross-Portfolio Opportunity Engine
// ---------------------------------------------------------------------------

enum OpportunityKind {
  payroll_float
  emd_or_marketing_capital
  project_funding
  advisor_or_client_acquisition
  shared_vendor_financing
  insurance_premium_financing
  tax_reserve_planning

  @@schema("interventure")
}

enum OpportunityState {
  /// Detected and going nowhere until Gardner approves it.
  detected
  gardner_approved
  /// Gardner said no. A row, not a deletion.
  gardner_declined
  /// Approved AND consent verified at the moment of transfer. The only state that permits an act.
  routed
  dismissed

  @@schema("interventure")
}

/// A capital opportunity detected across the Green Companies portfolio - blueprint 10.2.
///
/// **This model deliberately has no consent column.** Consent is per-handoff and re-checked live
/// at the moment of transfer (ADR-0018, principle 5); a stored `consented: true` would be a claim
/// about a permission that may have been revoked since. See ADR-0058.
model CrossPortfolioOpportunity {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// The venture the opportunity is FOR.
  venture String

  /// The client it concerns, when it concerns one. Null for a portfolio-level opportunity that
  /// names no client - which is the only kind that can be discussed without consent at all.
  clientId String? @db.Uuid

  kind  OpportunityKind
  state OpportunityState @default(detected)

  /// What was noticed, in the detector's words. No PII: this travels to Gardner.
  summary String

  /// What the detection rests on, so a reader can argue with it rather than with the conclusion.
  basis String

  detectedAt DateTime

  /// Gardner governs both sides and is the only party positioned to permit a handoff (ADR-0018).
  gardnerDecidedBy String?
  gardnerDecidedAt DateTime?
  gardnerNote      String?

  /// Set only when an act actually happened, after a live consent check.
  routedAt         DateTime?
  routedToDepartment String?

  dismissedReason String?

  createdAt DateTime @default(now())

  @@index([tenantId, state, detectedAt])
  @@index([tenantId, clientId])
  @@map("cross_portfolio_opportunities")
  @@schema("interventure")
}


// ---------------------------------------------------------------------------
// 8.1 Partner & Referrer Portal, 8.3 Partner Training & Certification
// ---------------------------------------------------------------------------

enum PartnerStatus {
  applied
  onboarding
  active
  suspended
  terminated

  @@schema("partners")
}

model Partner {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  legalName   String
  contactName String
  /// Contact email. Business contact detail for a company we have a commercial relationship with,
  /// not client PII - but it stays out of the Ledger like everything else.
  contactEmail String

  /// One of the seven tracks. Held as text and validated in code against PARTNER_TRACKS, so a
  /// track added by Channel Partnerships is a data change rather than a migration.
  track  String
  status PartnerStatus @default(applied)

  /// Qualifications actually produced, as the exact strings from TRACK_REQUIREMENTS.
  qualificationsRecorded String[]

  /// Set when onboarding completed. Absent means the partner never finished, which is a
  /// different fact from having finished and then been suspended.
  onboardedAt DateTime?

  suspendedAt   DateTime?
  terminatedAt  DateTime?
  /// Why the relationship ended, in the words of whoever ended it. Required to terminate.
  terminationReason String?
  terminatedBy      String? @db.Uuid

  createdAt DateTime @default(now())

  completions     PartnerModuleCompletion[]
  claimApprovals  PartnerClaimApproval[]
  brandConfigs    PartnerBrandConfig[]
  conductFindings PartnerConductFinding[]
  agreements      PartnerAgreement[]
  payouts         PartnerPayout[]
  clawbacks       PayoutClawback[]

  @@index([tenantId, status])
  @@index([tenantId, track])
  @@map("partners")
  @@schema("partners")
}

/// A curriculum module - blueprint 8.3. The MATERIAL lives elsewhere (SelfPublisherForge); this
/// records that a module exists, what it covers, and whether it is required to certify.
model PartnerCurriculumModule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  key     String
  version Int
  title   String
  /// What a partner is expected to know afterwards. Read by a person deciding whether a lapsed
  /// partner needs to retake it or only read a delta.
  objective String

  /// Which tracks must complete this. Empty means every track.
  requiredForTracks String[]

  /// Reference to the material. Not the material itself.
  materialReference String?

  publishedAt   DateTime @default(now())
  publishedBy   String   @db.Uuid
  supersededAt  DateTime?

  completions PartnerModuleCompletion[]

  @@unique([tenantId, key, version])
  @@index([tenantId, key])
  @@map("partner_curriculum_modules")
  @@schema("partners")
}

/// Completion is recorded against a module VERSION. A partner who completed v1 has not completed
/// v2, which is what makes "recertification with change delta training" expressible at all.
model PartnerModuleCompletion {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  partnerId String  @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  moduleId String                  @db.Uuid
  module   PartnerCurriculumModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  completedAt DateTime
  /// Who recorded it. Completion is attested by us, not self-reported by the partner.
  recordedBy String @db.Uuid

  @@unique([partnerId, moduleId])
  @@index([tenantId, partnerId])
  @@map("partner_module_completions")
  @@schema("partners")
}

/// Which 7.4 claims this partner is approved to make. Holds an ID, never claim text - a second
/// copy of the wording would drift from the library and the drifted copy is the one a partner
/// would actually say out loud.
model PartnerClaimApproval {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  partnerId String  @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  claimId String @db.Uuid

  approvedAt DateTime @default(now())
  approvedBy String   @db.Uuid
  withdrawnAt DateTime?

  @@unique([partnerId, claimId])
  @@index([tenantId, partnerId])
  @@map("partner_claim_approvals")
  @@schema("partners")
}

enum BrandArrangement {
  co_brand
  white_label

  @@schema("partners")
}

model PartnerBrandConfig {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  partnerId String  @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  arrangement BrandArrangement

  /// The name the partner presents under. Under a white label this is the partner's own.
  presentedName String
  /// Where the arrangement applies: a landing page, a document set, a workspace.
  surface String

  /// Rules the partner agreed to. Stated so a brand-usage review has something to check against.
  brandRules String[]

  approvedAt DateTime @default(now())
  approvedBy String   @db.Uuid
  revokedAt  DateTime?

  @@index([tenantId, partnerId])
  @@map("partner_brand_configs")
  @@schema("partners")
}

// ---------------------------------------------------------------------------
// 4.3 Call Recording, Summaries & Promise Tracking
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// 8.2 Partner Agreement & Payout Center
// ---------------------------------------------------------------------------

enum PartnerAgreementStatus {
  draft
  active
  superseded
  terminated

  @@schema("partners")
}

/// The commercial terms with one partner - blueprint 8.2's "referral fee terms".
///
/// Versioned and never edited in place. A payout cites the agreement version it was computed
/// under, so "what were we paying them in March" survives the terms changing in April.
model PartnerAgreement {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  partnerId String  @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  version Int

  /// The partner's share of the fee WE earned, in basis points. Basis points and integer cents
  /// throughout, per ADR-0011 - a percentage as a float is two figures in one table meaning
  /// different things.
  shareBasisPoints Int

  /// Free text the parties agreed. Not parsed; carried so a reader sees the terms behind the
  /// number rather than only the number.
  termsSummary String

  status PartnerAgreementStatus @default(draft)

  effectiveFrom DateTime
  supersededAt  DateTime?

  /// Level 3 human who activated it. An agreement that binds us to pay money is not an
  /// automatic act.
  activatedBy String?   @db.Uuid
  activatedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String   @db.Uuid

  payouts PartnerPayout[]

  @@unique([tenantId, partnerId, version])
  @@index([tenantId, partnerId, status])
  @@map("partner_agreements")
  @@schema("partners")
}

enum PayoutStatus {
  /// Computed and awaiting a human. Never pays anything on its own.
  pending_approval
  approved
  /// A human declined it, with a reason.
  declined

  @@schema("partners")
}

/// One period's payout for one partner.
///
/// `automatic in, human out`: the computation runs unattended, and nothing leaves without a
/// Level 3 approval. There is no status that means "paid" here - money movement is not this
/// system's act, and a `paid` we could set without anybody moving money would be a figure two
/// sets of books disagreed about.
model PartnerPayout {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  partnerId String  @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  agreementId String           @db.Uuid
  agreement   PartnerAgreement @relation(fields: [agreementId], references: [id])

  /// Half-open [periodStart, periodEnd), like every other window in this system.
  periodStart DateTime
  periodEnd   DateTime

  status PayoutStatus @default(pending_approval)

  /// The sum of the lines, minus clawbacks, in cents. Never negative: a period whose clawbacks
  /// exceed its earnings carries the remainder forward on the clawback rows rather than
  /// producing a payout that owes us money.
  netCents Int

  grossCents    Int
  clawbackCents Int

  computedAt DateTime

  decidedBy String?   @db.Uuid
  decidedAt DateTime?
  /// Required to decline. Declining a payout the terms say is owed is the decision that needs
  /// oversight; approving one does not, because the terms already said so.
  declineReason String?

  createdAt DateTime @default(now())

  lines PayoutLine[]

  @@index([tenantId, partnerId, periodStart])
  @@map("partner_payouts")
  @@schema("partners")
}

/// One referral's contribution to a payout, with the state rule that made it payable.
///
/// The citation and module version are copied onto the line rather than joined at read time.
/// A payout approved in March under version 3 of Nevada's module must still read as it did
/// after Nevada republishes - the evidence is what was relied on, not what is current.
model PayoutLine {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  payoutId String        @db.Uuid
  payout   PartnerPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  leadId   String  @db.Uuid
  clientId String? @db.Uuid

  /// The jurisdiction whose rule was applied.
  state String

  /// What we earned on this client in the period.
  grossFeeCents Int
  /// The share actually applied, after the state cap. May be below the agreement's share.
  appliedBasisPoints Int
  amountCents        Int

  /// Evidence, frozen at computation.
  rulePosture      ReferralFeePosture
  ruleCitation     String
  ruleConditions   String[]
  moduleVersion    Int
  cappedByState    Boolean            @default(false)

  createdAt DateTime @default(now())

  @@index([tenantId, payoutId])
  @@index([tenantId, leadId])
  @@map("payout_lines")
  @@schema("partners")
}

/// Money owed back because the engagement that earned it was refunded or charged back.
///
/// Its own row rather than a negative payout line, for ADR-0041's reason: a clawback is a thing
/// that happened, and netting it into an earlier figure loses that it happened at all.
model PayoutClawback {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  partnerId String  @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  /// The refund that triggered it. Null for a chargeback recorded by hand, which is a different
  /// fact and says so.
  refundRecordId String? @db.Uuid

  engagementId String @db.Uuid

  amountCents Int
  reason      String

  /// Set when a payout has absorbed it. Null means still outstanding, and the next computation
  /// picks it up.
  settledByPayoutId String?   @db.Uuid
  settledAt         DateTime?

  createdAt DateTime @default(now())
  createdBy String   @db.Uuid

  @@index([tenantId, partnerId, settledAt])
  @@map("payout_clawbacks")
  @@schema("partners")
}

enum CallStatus {
  consent_refused
  recording
  captured
  analysed

  @@schema("calls")
}

model CallRecord {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  status CallStatus @default(recording)

  /// Two-letter state code where the CLIENT is. Ours does not govern the recording rule.
  jurisdiction String
  /// Whether the client's own consent was required, and on what basis. Recorded WITH the call
  /// rather than derived later, because the rule may change and the question a regulator asks is
  /// what the rule was on the day.
  clientConsentRequired Boolean
  consentBasis          String

  purpose   String
  startedAt DateTime
  endedAt   DateTime?
  /// Who was on our side. Not the client - they are identified by clientId.
  internalParticipants String[]

  /// The VoiceForge reference, when a capture exists. Null while the vendor is ungated.
  recordingReference String?
  /// The transcript, once one exists. Null until VoiceForge is gated in.
  transcript Json?
  /// Set when analysis ran, so an un-analysed captured call is distinguishable from a clean one.
  analysedAt DateTime?

  createdAt DateTime @default(now())

  obligations CorrectionObligation[]

  @@index([tenantId, clientId, startedAt])
  @@index([tenantId, status])
  @@map("call_records")
  @@schema("calls")
}

enum ObligationStatus {
  open
  corrected
  dismissed

  @@schema("calls")
}

/// A promise made on a call that has to be corrected to the client.
///
/// NOT a verdict. The call already happened; there is nothing to block. See ADR-0015.
model CorrectionObligation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  callId String     @db.Uuid
  call   CallRecord @relation(fields: [callId], references: [id], onDelete: Cascade)

  kind     String
  severity String
  /// What was said, as said. A paraphrase is not what the client heard.
  excerpt      String
  speaker      String
  whyItMatters String

  status ObligationStatus @default(open)

  /// Who owes the correction and by when. Both required - an obligation with no owner is a note.
  owedBy String   @db.Uuid
  dueAt  DateTime

  /// What was actually said to the client to correct it. Required to close as `corrected`.
  correctionText String?
  correctedAt    DateTime?
  correctedBy    String?   @db.Uuid

  /// Required to close as `dismissed`, and a Level 3 human must do it.
  dismissalReason String?
  dismissedAt     DateTime?
  dismissedBy     String?   @db.Uuid

  createdAt DateTime @default(now())

  @@index([tenantId, status, dueAt])
  @@index([tenantId, clientId])
  @@map("correction_obligations")
  @@schema("calls")
}

// ---------------------------------------------------------------------------
// 4.5 Marketing Ops
// ---------------------------------------------------------------------------

enum CampaignStatus {
  draft
  active
  paused
  ended

  @@schema("marketing")
}

model Campaign {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  key    String
  name   String
  status CampaignStatus @default(draft)

  /// The value 1.3 records as a lead's sourceChannel. Fixed at creation: 1.3's attribution is
  /// written once, so a campaign that renamed its channel would orphan every lead it produced.
  sourceChannel String

  /// States this campaign runs in. Checked against 7.2 before activation - marketing into a
  /// state we are not activated in is the same exposure as serving a client there.
  jurisdictions String[]

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  createdBy String    @db.Uuid

  assets      MarketingAsset[]
  experiments Experiment[]

  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@map("campaigns")
  @@schema("marketing")
}

enum AssetState {
  draft
  in_review
  approved
  rejected
  retired

  @@schema("marketing")
}

model MarketingAsset {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  campaignId String?   @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  key   String
  kind  String
  state AssetState @default(draft)
  /// The copy itself. Scanned on every transition into review.
  body  String
  /// Where it came from: a Forge cascade, a person, a partner.
  sourceReference String?

  reviewedAt      DateTime?
  reviewedBy      String?   @db.Uuid
  rejectionReason String?

  createdAt DateTime @default(now())
  createdBy String   @db.Uuid

  @@index([tenantId, state])
  @@map("marketing_assets")
  @@schema("marketing")
}

enum ProposalStatus {
  submitted
  approved
  rejected

  @@schema("marketing")
}

/// A proposed addition to the 7.4 Marketing Claim Library.
///
/// Holds text only while it is UNAPPROVED. Approval publishes into 7.4 and the proposal keeps the
/// resulting claim id - it never becomes a second place approved wording lives.
model ClaimProposal {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  phrase       String
  intendedUse  String
  jurisdiction String?
  status       ProposalStatus @default(submitted)

  submittedBy String   @db.Uuid
  submittedAt DateTime @default(now())

  /// Set on approval. The claim in 7.4 that this became.
  publishedClaimId String?   @db.Uuid
  decidedBy        String?   @db.Uuid
  decidedAt        DateTime?
  decisionReason   String?

  @@index([tenantId, status])
  @@map("claim_proposals")
  @@schema("marketing")
}

model Experiment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  key        String
  hypothesis String

  startedAt DateTime?
  endedAt   DateTime?
  /// The variant declared the winner, when one was. Adoption is a separate decision.
  winningVariantKey String?

  createdAt DateTime @default(now())
  createdBy String   @db.Uuid

  variants ExperimentVariant[]

  @@unique([tenantId, key])
  @@map("experiments")
  @@schema("marketing")
}

/// Every variant must scan clean BEFORE the experiment runs. A variant that does not is rejected,
/// not entered as the arm we expect to lose - see ADR-0016.
model ExperimentVariant {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  experimentId String     @db.Uuid
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  key  String
  body String

  /// The scan that admitted it, recorded at the time. A later library change does not rewrite
  /// what was true when the variant was registered; `staleVariants` reports the divergence.
  scannedAt           DateTime
  scanVerdict         String
  requiredDisclosures String[]

  @@unique([experimentId, key])
  @@map("experiment_variants")
  @@schema("marketing")
}

// ---------------------------------------------------------------------------
// 10.1 Inter-Venture Commerce Hooks
// ---------------------------------------------------------------------------

/// A client that is also a Green Companies venture. Created by automatic detection, never by hand:
/// tagging by hand puts the control behind the knowledge it exists to supply.
model VentureRelationship {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  /// One of the keys in GREEN_COMPANIES. Held as text so the register is a data change.
  ventureKey  String
  displayName String

  /// The detection that produced this row, kept verbatim. A relationship somebody later disputes
  /// is asking what the system saw at the time.
  detectionBasis String

  /// Derived from venture status at creation and never settable. See ventures.ts.
  gardnerVisible Boolean

  taggedAt DateTime @default(now())

  disclosures ConflictDisclosure[]
  invoices    IntercompanyInvoice[]

  @@unique([tenantId, clientId])
  @@index([tenantId, ventureKey])
  @@map("venture_relationships")
  @@schema("interventure")
}

enum DisclosureState {
  drafted
  venture_acknowledged
  fully_acknowledged
  withdrawn

  @@schema("interventure")
}

/// A conflict-of-interest disclosure for one intercompany engagement.
///
/// Generating the ARTIFACT is automatic. Completing the DISCLOSURE is not: it needs an
/// acknowledgement from the venture and one from Gardner, and until both exist the engagement is
/// refused. A document the conflicted party wrote and filed with itself is a record of a control
/// that did not happen. See ADR-0018.
model ConflictDisclosure {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  relationshipId String              @db.Uuid
  relationship   VentureRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  /// The engagement this disclosure covers. One disclosure per engagement, never a standing one:
  /// a blanket conflict waiver is the thing this module exists to prevent.
  engagementId String @db.Uuid

  state DisclosureState @default(drafted)

  /// The generated text. Stored as generated so a later template change cannot rewrite what was
  /// acknowledged - 7.3's frozen-contract rule applied to a disclosure.
  body        String
  contentHash String

  generatedAt DateTime @default(now())

  /// The venture's own representative. The party the conflict is against.
  ventureAcknowledgedBy   String?
  ventureAcknowledgedAt   DateTime?
  ventureRepresentative   String?

  /// Gardner governs both sides and is the only party positioned to permit the engagement.
  gardnerAcknowledgedBy String?   @db.Uuid
  gardnerAcknowledgedAt DateTime?

  withdrawnAt     DateTime?
  withdrawnReason String?

  @@unique([tenantId, engagementId])
  @@index([tenantId, state])
  @@map("conflict_disclosures")
  @@schema("interventure")
}

enum DeviationDirection {
  discount
  premium

  @@schema("interventure")
}

/// A price charged to a venture that is not the published price.
///
/// Both directions are recorded and both need approval. A discount to a sibling moves profit out
/// of Burkham Wickmont; a premium moves it in. A system that questioned only discounts would
/// police one direction of the same thing.
model PricingDeviation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  engagementId String @db.Uuid
  clientId     String @db.Uuid
  ventureKey   String

  offerKey       String
  publishedCents Int
  chargedCents   Int
  direction      DeviationDirection
  /// Basis points of deviation from the published price, so a reviewer can sort by materiality.
  deviationBasisPoints Int

  /// Why. Required - an unexplained related-party price is the definition of the problem.
  basis String

  approvedBy String   @db.Uuid
  approvedAt DateTime @default(now())

  @@index([tenantId, clientId])
  @@map("pricing_deviations")
  @@schema("interventure")
}

enum HandoffState {
  proposed
  consented
  transferred
  declined

  @@schema("interventure")
}

/// A Founder Personal Layer handoff to Collingswood.
///
/// The data subject here is an INDIVIDUAL, not the business - personal-side complexity means the
/// founder's own finances. Consent is per handoff and lives in 1.5 as `cross_portfolio_handoff`.
model CrossPortfolioHandoff {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  state HandoffState @default(proposed)

  /// What was observed that makes a personal-layer referral appropriate. Required: a handoff with
  /// no stated reason is a referral fee looking for a justification.
  observation String
  /// What would actually be shared. Named at proposal time so the consent is informed.
  scope String

  proposedBy String   @db.Uuid
  proposedAt DateTime @default(now())

  /// The 1.5 consent that permitted it. Null until consented.
  consentId String? @db.Uuid

  transferredAt DateTime?
  declinedAt    DateTime?
  declinedReason String?

  @@index([tenantId, clientId, state])
  @@map("cross_portfolio_handoffs")
  @@schema("interventure")
}

enum InvoiceState {
  drafted
  routed_pending
  settled

  @@schema("interventure")
}

/// An intercompany invoice. Routing to the Gardner-level ledger is a seam - see invoicing.ts.
model IntercompanyInvoice {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  relationshipId String              @db.Uuid
  relationship   VentureRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  engagementId String @db.Uuid

  amountCents Int
  description String
  periodFrom  DateTime
  periodTo    DateTime

  /// Never `settled` while the Gardner ledger is unbuilt. A settled invoice nobody routed would
  /// read as money that moved between entities when none did.
  state InvoiceState @default(drafted)

  /// The Gardner-ledger reference, once one exists.
  gardnerLedgerReference String?

  raisedAt DateTime @default(now())
  raisedBy String   @db.Uuid

  @@index([tenantId, engagementId])
  @@map("intercompany_invoices")
  @@schema("interventure")
}


// ---------------------------------------------------------------------------
// 11.7 Admin Configuration Center
// ---------------------------------------------------------------------------

/// An append-only record of every configuration change.
///
/// There is no table of CURRENT values. The effective value is the latest applied change, or the
/// compiled default when there has never been one - so the audit trail is the store, and nothing
/// has to keep two copies in step. Rollback writes a NEW row restoring the prior value rather than
/// deleting anything: an undo that removed the row would answer "what is it now" and lose "what
/// happened", which is the question an audit asks.
model ConfigurationChange {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// `<package>.<CONSTANT_NAME>`, validated against the registry. A key outside it is refused, so
  /// a typo cannot create a setting nothing reads.
  key String

  previousValue Float
  newValue      Float

  /// Required. A parameter change with no reason is indistinguishable from a mistake.
  reason    String
  changedBy String @db.Uuid

  /// True for a high-risk parameter: recorded but not in force until promoted.
  staged Boolean @default(false)
  /// Null while staged. `effectiveValue` reads applied changes only, which is what makes staging
  /// real rather than a label.
  appliedAt  DateTime?
  promotedBy String?   @db.Uuid

  createdAt DateTime @default(now())

  @@index([tenantId, key, appliedAt])
  @@index([tenantId, appliedAt])
  @@map("configuration_changes")
  @@schema("admin")
}

// ---------------------------------------------------------------------------
// 11.6 Data Warehouse & Analytics Layer
// ---------------------------------------------------------------------------

/// An immutable point-in-time fact set.
///
/// The warehouse answers questions about the PAST. A live read tells you where clients stand
/// today; it cannot tell you where they stood in March, because those clients have moved and the
/// operational store keeps only the current value. See ADR-0020.
///
/// Never updated. Re-running a capture for a date already taken is REFUSED rather than
/// overwritten - an overwritten snapshot is a rewritten history, and having one is the point.
model AnalyticsSnapshot {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// The date this describes. One snapshot per tenant per date, enforced by the unique index.
  asOf DateTime @db.Date

  /// Aggregate facts, as captured. Counts and shares only - no client identifiers.
  facts Json

  /// What could not be captured, and why. Carried so a trend with a gap says where the gap is
  /// rather than reading as a dip.
  gaps String[]

  capturedAt DateTime @default(now())
  capturedBy String   @db.Uuid

  subjects SubjectSnapshot[]

  @@unique([tenantId, asOf])
  @@index([tenantId, asOf])
  @@map("analytics_snapshots")
  @@schema("warehouse")
}

/// A per-subject row, keyed by PSEUDONYM rather than client id.
///
/// Retention here outlives the operational record, which is what blueprint 11.6 means by
/// "historical retention independent of operational data retention". The subject key is a
/// pseudonym, NOT anonymisation: somebody holding the operational client list can still
/// re-identify it. Stating that limit is the honest version - see subjects.ts.
model SubjectSnapshot {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  snapshotId String            @db.Uuid
  snapshot   AnalyticsSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  /// Stable across snapshots for the same client, so a cohort can be followed through time.
  subjectKey String

  /// Cohort membership, decided at capture: the month the client was created.
  cohort String

  complianceState String
  /// Whether an engagement was live on the snapshot date.
  engaged Boolean
  /// Cents billed to date. A trend over this is the retention curve blueprint 11.6 asks for.
  billedToDateCents Int

  @@unique([snapshotId, subjectKey])
  @@index([tenantId, subjectKey])
  @@index([tenantId, cohort])
  @@map("subject_snapshots")
  @@schema("warehouse")
}

// ---------------------------------------------------------------------------
// 11.1 Identity & Access - client users, for the 11.10 Client Portal
// ---------------------------------------------------------------------------

/// A person who signs in to the Client Portal.
///
/// DELIBERATELY NOT AN `Actor`. An Actor carries an authority level 0-3, and `vault.read` grants
/// access on tenant + level with NO ownership check - correctly, because an internal analyst reads
/// many clients' files. `bank_statement` sits at level 0. A client holding a Level 0 Actor row
/// could therefore read any client's bank statements in the tenant. See ADR-0021.
model ClientUser {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// The one file this user may act on. Not a list: a person who needs two files gets two users,
  /// so that revoking one cannot silently leave the other.
  clientId String @db.Uuid

  /// Lowercased at write. Unique per tenant, not globally - the same person may be a client of
  /// two tenants and those are different relationships.
  email String

  /// `scrypt$N$r$p$salt$hash`. Never returned, never logged, never in a Ledger payload.
  ///
  /// Overwritten with a sentinel that cannot verify once the password is removed - `verifyPassword`
  /// needs six `$`-separated parts beginning `scrypt`, and the sentinel is not that.
  passwordHash String

  /// Set when the account has no password AT ALL - not merely one that no longer signs anybody in.
  ///
  /// **Two independent facts.** This column is what every gate reads; the hash is destroyed at the
  /// same moment so that a column somebody edits back to null cannot resurrect a credential. The
  /// weaker fact cannot undo the stronger one.
  passwordRemovedAt DateTime?

  displayName String

  /// Consecutive failures since the last success. Reset on success, not on a timer.
  failedAttempts Int @default(0)
  /// Set when locked. Cleared by a successful sign-in after it has passed.
  lockedUntil DateTime?

  /// Null until the invitation is accepted. An unenrolled user cannot authenticate.
  enrolledAt DateTime?
  lastSignInAt DateTime?

  /// Set when the client has switched password sign-in OFF, having registered two passkeys.
  ///
  /// **This is what makes a passkey a security property rather than a convenience.** An account is
  /// as strong as the weakest method it will accept, so a passkey beside a live password is still
  /// phished by a proxy that takes the password and a code. With this set, a correct password is
  /// refused at sign-in - and refused with the SAME sentence every other failure gets, because a
  /// message saying "this account is passkey-only" tells an attacker which accounts to stop guessing.
  ///
  /// A completed password reset does NOT clear it. Otherwise the email channel is a way to re-open
  /// the phishable path the client deliberately closed.
  passwordSignInDisabledAt DateTime?

  /// Set when access is withdrawn. Sessions are checked against this on every resolve, so
  /// disabling takes effect on the next request rather than when a session happens to expire.
  disabledAt DateTime?
  disabledReason String?

  createdAt DateTime @default(now())

  sessions ClientSession[]
  invitations ClientInvitation[]
  passwordResets ClientPasswordReset[]
  mfaFactors ClientMfaFactor[]
  mfaChallenges ClientMfaChallenge[]
  recoveryCodes ClientRecoveryCode[]
  emailChanges ClientEmailChange[]
  webauthnChallenges ClientWebauthnChallenge[]

  @@unique([tenantId, email])
  @@index([tenantId, clientId])
  @@map("client_users")
  @@schema("identity")
}

/// An invitation to enrol. Enrolment is by invitation, never self-service: a client cannot create
/// an account and name the file it belongs to.
model ClientInvitation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  clientUserId String     @db.Uuid
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token. The token itself is returned once, at issue, and never stored - a
  /// leaked database gives an attacker the same thing it gives them for a password: nothing
  /// directly usable.
  tokenHash String @unique

  /// Who issued it. A Level 3 human, checked at issue.
  issuedBy String   @db.Uuid
  issuedAt DateTime @default(now())
  expiresAt DateTime

  /// Single use. Set when accepted; a second attempt with the same token is refused.
  acceptedAt DateTime?

  @@index([tenantId, clientUserId])
  @@map("client_invitations")
  @@schema("identity")
}

/// A pending password reset.
///
/// Separate from `ClientInvitation` although the mechanics rhyme, because the two answer different
/// questions and one field of difference decides which: an invitation is issued to somebody who has
/// no account yet, and a reset to somebody who has one and cannot get into it. Merging them would
/// mean one expiry, one issuing rule and one audit story for two acts with different threat models.
model ClientPasswordReset {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  clientUserId String     @db.Uuid
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token. The token is handed to the delivery seam or returned once to the
  /// issuing staff member, and is never stored, logged or put in a Ledger payload.
  tokenHash String @unique

  /// How the reset was asked for. A self-service request is unauthenticated by definition; a
  /// staff-assisted one carries a human who is answerable for it.
  source ClientPasswordResetSource

  /// Null for a self-service request - the same reasoning as 6.4's `listedBy`: automatic in, human
  /// out, and no invented name in the field a reviewer reads. Set to the Level 3 human otherwise.
  issuedBy String? @db.Uuid

  /// How a staff member satisfied themselves the caller was the client. Required for a
  /// staff-assisted reset, because the attack on helpdesk password reset is social engineering
  /// rather than cryptography.
  verificationBasis String?

  requestedAt DateTime @default(now())
  /// Short. An invitation may sit in an inbox for days; a reset is used within minutes of being
  /// asked for, and every extra hour is an hour a forwarded email stays live.
  expiresAt DateTime

  /// Single use. Set when the new password is set.
  consumedAt DateTime?
  /// Set when a newer reset replaced this one. Two live tokens would mean spending one and leaving
  /// the other.
  supersededAt DateTime?

  @@index([tenantId, clientUserId])
  @@map("client_password_resets")
  @@schema("identity")
}

enum ClientPasswordResetSource {
  self_service
  staff_assisted

  @@schema("identity")
}

/// A second authentication factor. TOTP today; the model carries a kind because WebAuthn is the
/// next one and a boolean column would have to be replaced rather than extended.
model ClientMfaFactor {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  clientUserId String     @db.Uuid
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  kind ClientMfaKind @default(totp)

  /// The TOTP shared secret, field-encrypted (`@bwc/crypto`) under a key that is not in this
  /// database. **Null for a WebAuthn factor**, which has no shared secret at all - that is the
  /// point of it, and the reason a leaked database yields nothing usable for one.
  ///
  /// Unlike a password hash a TOTP secret MUST be recoverable - codes are computed from it - so the
  /// protection cannot be a one-way function. A leaked database without the key yields ciphertext;
  /// a leaked database WITH the key yields working second factors, which is why the key belongs in
  /// a secret manager and ultimately in the HSM §6.2 wants.
  secretCiphertext String?

  /// The credential id the authenticator returned, base64url. Unique, so one security key cannot be
  /// registered twice or against two accounts.
  credentialId String? @unique
  /// The credential's public key, base64url. **Public**: a leaked database gives an attacker the
  /// thing that verifies a signature, not the thing that produces one.
  publicKey String?
  /// The authenticator's signature counter at the last accepted assertion.
  ///
  /// A value that does not advance means two authenticators are answering for one credential - a
  /// clone. Enforced only once a credential has shown it uses a counter: many authenticators do not
  /// implement one and always report zero, and refusing that would reject every passkey in
  /// existence.
  signCount Int?
  /// Comma-separated transport hints from the browser, for a nicer prompt next time.
  transports String?
  /// What the client calls it. Two keys are indistinguishable without one, and a factor a client
  /// cannot identify is one they will not dare remove.
  label String?

  /// Whether the credential is DISCOVERABLE - a resident key the authenticator can offer without
  /// being told which account, and the only kind that can sign somebody in without an email typed.
  ///
  /// Registered with user verification required, because standing alone a passkey has to carry both
  /// halves: something the client has plus something they know or are, in one gesture. A
  /// second-factor credential is not promoted into a first-factor one by accident - the flag is set
  /// at registration and read at sign-in.
  discoverable Boolean @default(false)

  /// Null until a code from the new authenticator has verified. **A factor nobody has proved they
  /// can use is not a factor; it is a lockout waiting for the next sign-in.**
  confirmedAt DateTime?

  /// The last time step accepted for this factor. A code at or below it is refused, which is what
  /// stops an observed code being replayed inside its validity window.
  lastUsedStep BigInt?

  createdAt DateTime  @default(now())
  /// Set when withdrawn. Rows are retired rather than deleted: which factor was in force when is a
  /// question an access review asks.
  removedAt DateTime?
  removedBy String?   @db.Uuid
  /// How a staff member verified the caller before removing a factor on their behalf. Null when the
  /// client removed their own.
  removalVerificationBasis String?

  /// Registration order, from a Postgres sequence. See `LeadActivity.seq` for the argument.
  ///
  /// A client with two keys is shown a list and asked to remove one of them. `createdAt` is
  /// `timestamp(3)` and two keys registered back to back land in the same millisecond often enough
  /// that the settings test failed about one run in ten before this column existed. A list that
  /// reorders itself between reloads is how somebody revokes the wrong key.
  seq BigInt @unique @default(autoincrement())

  @@index([tenantId, clientUserId, createdAt, seq])
  @@map("client_mfa_factors")
  @@schema("identity")
}

enum ClientMfaKind {
  totp
  /// A security key or platform authenticator. Bound to the ORIGIN, which is what makes it
  /// phishing-resistant in a way TOTP is not.
  webauthn

  @@schema("identity")
}

/// A challenge issued for a WebAuthn ceremony, registration or authentication.
///
/// Server-generated, stored, single use and short-lived. A challenge the client could choose, or
/// reuse, is a replayable signature - the whole ceremony rests on the value being ours and being
/// spent.
model ClientWebauthnChallenge {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// **Null for a passwordless sign-in**, which belongs to no user yet - that is what discoverable
  /// means. The column admits it rather than being given a placeholder that would have to be
  /// remembered as meaningless.
  clientUserId String?     @db.Uuid
  clientUser   ClientUser? @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  /// base64url, as the browser will echo it back.
  challenge String @unique
  ceremony  ClientWebauthnCeremony

  issuedAt  DateTime @default(now())
  expiresAt DateTime
  consumedAt DateTime?

  @@index([tenantId, clientUserId])
  @@map("client_webauthn_challenges")
  @@schema("identity")
}

enum ClientWebauthnCeremony {
  registration
  authentication

  @@schema("identity")
}

/// A password accepted, a second factor still outstanding.
///
/// **Deliberately not a session.** Issuing a session here and marking it unsatisfied would put the
/// check on every route, and the route that forgot would be a complete bypass. There is no
/// half-authenticated session because there is no way to express one.
model ClientMfaChallenge {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  clientUserId String     @db.Uuid
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  /// SHA-256 of the challenge token. Returned once, never stored.
  tokenHash String @unique

  issuedAt  DateTime @default(now())
  /// Minutes, not hours. It exists only for as long as it takes to read six digits off a phone.
  expiresAt DateTime

  /// Wrong codes against THIS challenge. The challenge dies rather than the account: a caller who
  /// exhausts it is thrown back to the password, which is itself rate limited and lockout-protected.
  failedAttempts Int @default(0)

  satisfiedAt DateTime?
  abandonedAt DateTime?

  @@index([tenantId, clientUserId])
  @@map("client_mfa_challenges")
  @@schema("identity")
}

/// A single-use code for the client who no longer has their authenticator.
///
/// Without these, a lost phone is a permanent lockout whose only remedy is a phone call to the firm
/// - which is the social-engineering path ADR-0023 exists to constrain.
model ClientRecoveryCode {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  clientUserId String     @db.Uuid
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  /// SHA-256. These are high-entropy values we generated, so a single hash is the right tool -
  /// the same reasoning as session and reset tokens, and the opposite of a password.
  codeHash String @unique

  issuedAt DateTime  @default(now())
  usedAt   DateTime?
  /// Set when a new set was issued. Regenerating retires every previous code, so a printout the
  /// client has replaced cannot still open the account.
  supersededAt DateTime?

  @@index([tenantId, clientUserId])
  @@map("client_recovery_codes")
  @@schema("identity")
}

/// A move of the address a client's account - and therefore their account recovery - lives at.
///
/// **The strongest of the three credential operations.** Changing a password changes what an
/// attacker must know; changing this changes where recovery GOES, and an attacker who moves it keeps
/// the account even after the client resets their password, because the reset arrives in the
/// attacker's inbox.
///
/// A consumed row is also the history: it records the address it replaced.
model ClientEmailChange {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  clientUserId String     @db.Uuid
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  /// Lowercased at write. Not applied to the user until the change completes: an address the
  /// account moved to before anybody proved it was reachable is a lockout the client discovers on
  /// the day they need to get back in.
  newEmail String

  /// The address this replaced. Written at completion, which is the only moment it is known to be
  /// the one being left.
  previousEmail String?

  /// SHA-256 of the verification token, delivered to the NEW address. Never stored in the clear.
  tokenHash String @unique

  source ClientEmailChangeSource

  /// **The distinction that has to survive.** `email` means a token sent to the new address came
  /// back, which proves the address is reachable. `staff_assertion` means a Level 3 human vouched
  /// for the caller - which proves the PERSON and proves nothing about the address. When somebody
  /// asks later how an account's recovery channel moved, the answer belongs in a column rather than
  /// in an inference.
  verifiedBy ClientEmailVerification?

  /// The Level 3 human, for a staff-assisted change. Null for self-service, as 6.4's `listedBy` is.
  requestedBy String? @db.Uuid
  /// How that human satisfied themselves the caller was the client.
  verificationBasis String?

  requestedAt DateTime @default(now())
  /// Short, for the same reason a reset is: the token is used within minutes of being asked for.
  expiresAt DateTime

  consumedAt DateTime?
  /// Set when a newer request replaced this one, or when the client recovered their account -
  /// completing a password reset or a change cancels every pending move, so an attacker's request
  /// cannot complete after the client has taken their account back.
  cancelledAt DateTime?
  cancelledReason String?

  @@index([tenantId, clientUserId])
  @@map("client_email_changes")
  @@schema("identity")
}

enum ClientEmailChangeSource {
  self_service
  staff_assisted

  @@schema("identity")
}

enum ClientEmailVerification {
  /// A token delivered to the new address was presented. The address is reachable.
  email
  /// A Level 3 human vouched for the caller. The address is NOT known to be reachable.
  staff_assertion

  @@schema("identity")
}

/// A per-source attempt counter, shared by every instance of the portal process.
///
/// **In the `identity` schema on purpose.** 11.1 already owns the other half of this control:
/// per-account lockout. Rate limiting and lockout are the two halves of one answer - one counts the
/// victim, the other counts the attacker - and keeping the two counters in one schema is what stops
/// somebody changing one without seeing the other.
model RateLimitCounter {
  /// `scope:key`. The scope namespaces sign-in from password reset, which are separate budgets;
  /// the key is what `rateLimitKey` derived from the request.
  ///
  /// **The key is an IP address and it is stored as one.** A hash would look like pseudonymity and
  /// would not be any: IPv4 is four billion values, so an unsalted digest is a lookup table and a
  /// salted one needs a secret this table would then have to be given. ADR-0020's rule - claiming
  /// anonymity you do not have is worse than not claiming it - applies. What limits the exposure is
  /// retention: rows live for one window plus the sweep interval, and none of this reaches the
  /// Ledger or a log.
  id String @id

  /// Attempts inside the current window. Incremented by ONE atomic statement, never read-then-write:
  /// two instances that both read 4 and both write 5 have let six requests through on a limit of
  /// five, and that is invisible to a sequential test.
  attempts Int @default(1)

  /// When the current window opened. A request arriving after `windowStartedAt + window` resets the
  /// row rather than creating a second one.
  windowStartedAt DateTime

  /// Last touched. What the sweep reads.
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
  @@map("rate_limit_counters")
  @@schema("identity")
}

/// A signed-in session.
model ClientSession {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  clientUserId String     @db.Uuid
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  /// SHA-256 of the session token. The token is returned once and never stored.
  tokenHash String @unique

  issuedAt DateTime @default(now())
  /// Absolute expiry. A session ends at this point however active it has been.
  expiresAt DateTime
  /// Moved forward on each resolve, for the idle window. Both expiries are checked every time.
  lastSeenAt DateTime @default(now())

  revokedAt DateTime?

  @@index([tenantId, clientUserId])
  @@map("client_sessions")
  @@schema("identity")
}

/// How a staff member proves they are the Actor they claim to be.
///
/// **Bound to the existing Actor rather than a parallel StaffUser.** The Actor already carries the
/// tenant, the Authority Level and the department, and every Ledger event already names an actor id.
/// A separate staff identity would mean sign-in and the audit trail answer "who did this" with two
/// different keys, and reconciling them would be somebody's job forever.
///
/// One row per Actor, or none. **An Actor with no row cannot sign in** - the same structural default
/// as ADR-0007 governance and ADR-0009 state activation: absence is not permission. Village agents
/// have no row and are not meant to; they act through the worker, not through a browser.
model ActorCredential {
  id String @id @default(uuid()) @db.Uuid

  actorId String @unique @db.Uuid
  actor   Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  /// Denormalised from the Actor so the sign-in lookup is one indexed read on (tenantId, email)
  /// before anything is trusted. Kept in step by the only writer, which is enrolment.
  tenantId String @db.Uuid

  /// Lowercased at write. Unique per tenant.
  email String

  /// `scrypt$N$r$p$salt$hash`. Never returned, never logged, never in a Ledger payload.
  passwordHash String

  /// The TOTP shared secret, field-encrypted (`@bwc/crypto`) under a key that is not in this
  /// database - the same treatment `ClientMfaFactor` gives a client's.
  ///
  /// **Not nullable in practice: a staff credential without one cannot complete enrolment.** The
  /// column is nullable only for the window between the password being set and the first code being
  /// proved, and `enrolledAt` is what every gate reads.
  totpSecretCiphertext String?

  /// The last time step accepted. A code at or below it is refused, so an observed code cannot be
  /// replayed inside its own validity window.
  totpLastUsedStep BigInt?

  /// Null until a code from the authenticator has verified. **Until then the account cannot sign
  /// in at all** - not "can sign in with one factor". Staff MFA is a precondition of enrolment
  /// rather than a setting, because a staff session opens every client file in the tenant.
  enrolledAt DateTime?

  /// Consecutive failures since the last success. Reset on success, not on a timer.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  lastSignInAt DateTime?

  /// Set when access is withdrawn. Read on every session resolve, so revocation takes effect on the
  /// next request rather than when a session happens to lapse.
  disabledAt     DateTime?
  disabledReason String?

  createdAt DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("actor_credentials")
  @@schema("identity")
}

/// A signed-in staff session. Same two-expiry design as `ClientSession`, tighter windows.
model ActorSession {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  actorId String @db.Uuid
  actor   Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  /// SHA-256 of the session token. The token is returned once and never stored.
  tokenHash String @unique

  issuedAt DateTime @default(now())
  /// Absolute expiry. A session ends here however active it has been.
  expiresAt DateTime
  /// Moved forward on each resolve, for the idle window. Both are checked every time.
  lastSeenAt DateTime @default(now())

  revokedAt DateTime?

  @@index([tenantId, actorId])
  @@map("actor_sessions")
  @@schema("identity")
}

/// An invitation to take up a Console credential.
///
/// **The granter never sees the password or the authenticator secret.** They see this token, which
/// is single-use, expiring, and can only be spent to SET a credential - not to use one. The subject
/// chooses their own password and receives their own secret when they spend it.
///
/// That is a weaker thing to hold than what the first version of this flow handed a granter, and it
/// is not nothing: whoever holds an unspent token can spend it. What closes that is delivering it to
/// the subject rather than to the person who created it, and delivery needs the email provider
/// nothing here has yet. See ADR-0036.
model ActorInvitation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  actorId String @db.Uuid
  actor   Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token. The token is returned once, at issue, and never stored.
  tokenHash String @unique

  /// Who issued it. A Level 3 human, checked at issue.
  issuedBy  String   @db.Uuid
  issuedAt  DateTime @default(now())
  expiresAt DateTime

  /// Single use. Set when spent; a second attempt with the same token is refused.
  acceptedAt DateTime?

  @@index([tenantId, actorId])
  @@map("actor_invitations")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// 5.5 Funding Outcome Ledger
//
// The module that gives 9.1 a denominator. Every other table in this system
// that touches placement records an APPROVAL - `billing.funding_outcomes` has
// an approved credit limit and an approval date and no column for a denial -
// so an approval rate computed from what existed would read 100% forever.
// Arithmetically correct, completely meaningless, and the single most damaging
// sentence a dashboard here could produce, because "our approval rate is 100%"
// is exactly the claim 7.4 bans.
//
// So the record is an ATTEMPT, and its outcome is one of the things that can
// happen to an attempt. A declined attempt is a row, not an absence.
// ---------------------------------------------------------------------------

/// What happened to an attempt.
///
/// `pending` is a real state, not a placeholder: an application sitting with a provider is a fact
/// about the world, and it must not count in either half of a rate. `withdrawn` is excluded from
/// the denominator for the reason 5.2 already gives - a withdrawn application was never decided,
/// and counting it as a non-approval makes a provider look worse the more clients change their minds.
enum FundingAttemptOutcome {
  pending
  approved
  declined
  withdrawn

  @@schema("outcomes")
}

/// Blueprint 5.5 lists "client satisfaction" in the data model.
///
/// Categorical, and with an explicit `not_asked`. A numeric satisfaction score would invite exactly
/// the averaging Decision E forbids elsewhere, and a nullable number would make "we did not ask"
/// indistinguishable from a zero once anybody aggregated it.
enum ClientSatisfaction {
  not_asked
  delighted
  satisfied
  dissatisfied

  @@schema("outcomes")
}

/// One attempt to place one client with one provider.
///
/// **`requestedCents` and `approvedCreditLimitCents` are different columns and neither is derived
/// from the other.** This is the Seek Capital lesson in its original form: `creditLimit` is what was
/// asked for, `approvedCreditLimit` is what was granted, and a success fee computed against the
/// first is a revenue-integrity bug that looks like a rounding difference. The CHECK constraints in
/// this table's migration make the wrong shapes unwritable rather than merely discouraged.
///
/// Time to approval and time to funding are NOT stored. They are differences between columns that
/// are already here, and a stored duration is a second copy that goes stale the moment a date is
/// corrected.
model FundingAttempt {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  clientId String @db.Uuid

  /// The engagement the fee hangs off. Required: an attempt with no engagement cannot produce a
  /// success fee, cannot produce a refund entitlement, and is invisible to 1.4 - which is the
  /// state that let approvals and refunds disagree in the first place.
  engagementId String @db.Uuid

  /// The 5.2 provider. Not an FK: `lenders` is another module's schema and this one does not reach
  /// into it - the provider is read through `@bwc/lenders`, and the id is carried here so the
  /// feedback loop can be written back through the same door.
  providerId  String      @db.Uuid
  productKind ProductKind

  /// What the client asked for. **Never the basis of a fee.**
  requestedCents Int

  submittedAt DateTime

  outcome   FundingAttemptOutcome @default(pending)
  decidedAt DateTime?

  /// What was granted. Null while pending, null on a decline, and the only figure a success fee may
  /// compute against. Null is not zero: a declined attempt was not approved for nothing, it was not
  /// approved.
  approvedCreditLimitCents Int?

  /// Required on a decline, in the provider's words where they gave them. A decline with no stated
  /// reason teaches 5.2 nothing and gives the client no adverse-action explanation.
  declineReason String?

  fundedOn    DateTime?
  fundedCents Int?

  /// Coarse cohort bucket, the same key 5.2 computes. Coarse on purpose: a finer key gives every
  /// client a cohort of one, and a cohort of one produces rates of exactly 0% or 100%.
  clientProfileKey String

  underwritingNotes   String?
  nextRecommendedMove String?

  satisfaction ClientSatisfaction @default(not_asked)

  /// The `billing.funding_outcomes` row this attempt produced, when it was approved. Set by 5.5,
  /// which is the only thing that should create one - it is what the 60-day refund trigger runs
  /// against, and an approval recorded here but not there is a refund that never fires.
  billingOutcomeId String? @db.Uuid

  recordedBy String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, clientId])
  @@index([tenantId, engagementId])
  @@index([tenantId, providerId, productKind])
  @@index([tenantId, clientProfileKey])
  @@index([tenantId, outcome, decidedAt])
  @@map("funding_attempts")
  @@schema("outcomes")
}

// ---------------------------------------------------------------------------
// 7.5 Legal Hold & Record Retention
//
// The vault (3.2) already refuses to delete a document under legal hold, and
// already refuses to delete one with no resolved retention schedule - saying,
// honestly, that 7.2 and 7.5 do not exist. This module is what those refusals
// were waiting for: the schedules, and the holds.
//
// Two shapes, and the asymmetry between them is the design:
//
//   A HOLD is a MATTER, not a flag on a document. A litigation hold covers a
//   client's file, including the statement they upload tomorrow. Storing it as
//   a boolean per document means propagating on placement, and anything
//   arriving after the propagation is silently outside the hold - which is the
//   classic way an organisation destroys evidence while believing it preserved
//   it. Holds are therefore EVALUATED at the moment of the decision, never
//   copied onto rows.
//
//   A SCHEDULE is an AUTHORISATION. Absence of a hold means not held; absence
//   of a schedule means NOT PERMITTED TO DELETE. The two absences point in
//   opposite directions and both are right, because a hold restricts and a
//   schedule permits. ADR-0007 and ADR-0009 already say absence is not
//   permission; this is the same rule read carefully enough to notice which
//   side of it each record is on.
// ---------------------------------------------------------------------------

/// Why a hold exists. Blueprint 7.5 names litigation, complaint and regulator request; a client
/// dispute is added because 6.3 produces them and they are the fourth thing that stops a deletion.
enum LegalHoldKind {
  litigation
  complaint
  regulator_request
  client_dispute

  @@schema("retention")
}

/// How wide a hold reaches.
///
/// `client` is the common case and the one a boolean-per-document design gets wrong. `tenant` is
/// deliberately available and deliberately blunt: a regulator asking for everything is a real
/// event, and the alternative is a hundred per-client holds somebody has to remember to place.
enum LegalHoldScope {
  tenant
  client
  document_kind

  @@schema("retention")
}

/// A litigation, complaint or regulator hold.
///
/// **Evaluated, never propagated.** Nothing here writes to `vault.vault_documents`. The vault asks
/// this table at the moment somebody tries to delete or export, so a document uploaded after the
/// hold was placed is covered by it without anybody re-running anything.
///
/// Released rather than deleted: which hold was in force when a document was destroyed is the
/// question a spoliation claim turns on, and a deleted row cannot answer it.
model LegalHold {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  kind  LegalHoldKind
  scope LegalHoldScope

  /// Set when `scope` is `client`. Null for a tenant-wide hold - and null MEANS tenant-wide here
  /// rather than meaning unknown, which is why `scope` is stored explicitly beside it. A nullable
  /// column carrying two meanings is how a hold ends up covering nothing.
  clientId String? @db.Uuid

  /// Set when `scope` is `document_kind`. Uses the vault's own enum across the schema boundary, so
  /// a kind that exists in one module and not the other is a compile error rather than a hold that
  /// silently matches nothing.
  documentKind DocumentKind?

  /// The matter. A case number, a complaint reference, a regulator's request id - whatever a
  /// person would use to look it up. Required: a hold nobody can trace to a matter is a hold
  /// nobody will ever dare release.
  matterReference String

  /// Why, in the words of whoever placed it. Read back to a court, potentially.
  reason String

  placedBy String   @db.Uuid
  placedAt DateTime

  /// Blueprint 7.5 does not ask for a cadence and one is here anyway, because a hold that outlives
  /// its matter is the cost of getting the direction of harm right. See ADR-0042: an overdue
  /// review KEEPS HOLDING and is flagged, exactly as 6.4's listing does and for the same reason.
  reviewCadenceDays Int       @default(180)
  lastReviewedAt    DateTime?
  lastReviewedBy    String?   @db.Uuid

  releasedAt    DateTime?
  releasedBy    String?   @db.Uuid
  releaseReason String?

  createdAt DateTime @default(now())

  @@index([tenantId, releasedAt])
  @@index([tenantId, clientId, releasedAt])
  @@map("legal_holds")
  @@schema("retention")
}

/// How long a document of a given kind must be kept.
///
/// **A schedule is an authorisation to destroy, which is why absence blocks.** The vault refuses to
/// delete a document with no resolved schedule, and it is right to: over-retention is a liability
/// and destroying a record a regulator was entitled to see is the irreversible one.
///
/// State-specific rows override the default for the same kind. `stateCode` null IS the default - a
/// sentinel row rather than a separate table, so "what applies in Texas" is one query with an
/// ordering rather than two queries and a merge somebody will get wrong.
model RetentionSchedule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  documentKind DocumentKind

  /// Two-letter state code, or null for the default that applies where no state rule is recorded.
  stateCode String?

  /// Months from the document's own date. Months rather than days because that is the unit every
  /// statute is written in, and converting at write time loses which one was meant.
  retainMonths Int

  /// Provenance, per Decision D, and non-nullable for the same reason a lender rule's is: a
  /// retention period nobody researched, presented with the same confidence as one read out of a
  /// statute, is the failure principle 8 exists to prevent. Here it decides whether a document is
  /// destroyed.
  ///
  /// `issuer_rule` is the tag for a period read from a statute or a regulator's guidance - the
  /// enum is reused from 5.2 rather than duplicated, because Decision D makes provenance
  /// portfolio-wide vocabulary and a second enum would drift.
  provenanceTag ProvenanceTag

  /// Populated for `issuer_rule`: the citation, when it was last checked, and by whom.
  sourceUrl    String?
  lastVerified DateTime?
  verifiedBy   String?

  /// Populated for `unresearched_default` - why the assumption is a reasonable one to hold.
  rationale String?

  recordedBy String   @db.Uuid
  createdAt  DateTime @default(now())

  /// Superseded rather than updated. What the schedule said when a document was destroyed is the
  /// question an audit asks, and an overwritten row cannot answer it.
  supersededAt DateTime?
  supersededBy String?   @db.Uuid

  @@index([tenantId, documentKind, stateCode, supersededAt])
  @@index([tenantId, provenanceTag])
  @@map("retention_schedules")
  @@schema("retention")
}

/// Blueprint 7.5's "client data deletion request workflow (GDPR / CCPA analog)".
enum DeletionRequestStatus {
  received
  refused
  approved
  completed

  @@schema("retention")
}

/// A client asking for their data to be deleted.
///
/// Recorded even when it will be refused, and **especially** then: "we received your request on the
/// 3rd and refused it on the 5th because these records are under a litigation hold" is the answer a
/// regulator wants, and a request that was quietly dropped produces no answer at all.
model DeletionRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  clientId String @db.Uuid

  /// Who asked. A client user, or a staff member recording a request made by phone or letter.
  requestedBy String   @db.Uuid
  requestedAt DateTime

  /// In the client's words where they gave them.
  requestDetail String

  status DeletionRequestStatus @default(received)

  decidedAt DateTime?
  decidedBy String?   @db.Uuid
  /// Required on a refusal. What blocked it: a hold, a retention period, or both.
  decisionReason String?

  completedAt DateTime?
  /// How many documents were destroyed. Recorded because "we deleted everything" is not a claim
  /// anybody should have to take on trust.
  documentsDeleted Int?

  createdAt DateTime @default(now())

  @@index([tenantId, clientId, status])
  @@map("deletion_requests")
  @@schema("retention")
}

// ---------------------------------------------------------------------------
// 8.4 Partner Risk Score
//
// Blueprint 8.4 asks for a "score across dimensions", and the dimensions it
// lists are two different kinds of thing wearing one name:
//
//   claim compliance, unauthorized promises detected, documentation quality
//     - conduct. Categorical. A partner either promised a client an approval
//       or did not.
//
//   conversion rate, complaint rate, refund rate, revenue contribution
//     - performance. Numeric, and meaningless below a sample.
//
// They are never combined into one figure. A single number lets revenue
// contribution offset an unauthorized promise, which is precisely the trade
// design principle 1 exists to forbid - and it would do it invisibly, because
// the arithmetic gives no sign that one input was a compliance breach. So the
// standing is worst-of over conduct, the measures are reported separately with
// their denominators, and nothing in this module averages the two.
//
// See ADR-0043.
// ---------------------------------------------------------------------------

/// What a partner did. Blueprint 8.4's conduct dimensions, as an enum rather than free text,
/// because "how many unauthorized promises has this partner made" is a query Channel Partnerships
/// runs rather than a scan of somebody's notes.
enum PartnerFindingKind {
  /// A promise no partner may make: guaranteed approval, a specific amount, credit repair.
  /// The gravest of these and the reason the enum exists - it is a Level 4 prohibited action
  /// performed by somebody outside the authority system.
  unauthorized_promise
  /// Language outside the approved claims library (7.4).
  unapproved_claim
  /// A client complained about the partner or about how they were introduced.
  client_complaint
  /// Referrals arriving without the documentation the track requires.
  documentation_gap
  /// Brand or co-brand usage outside what was approved (8.1).
  brand_misuse
  /// Anything a human recorded that the list above does not cover.
  other

  @@schema("partners")
}

/// How bad. Deliberately the same four words 6.5 uses, so a reader moving between the two modules
/// does not have to learn a second severity vocabulary.
enum PartnerFindingSeverity {
  critical
  serious
  notable
  context

  @@schema("partners")
}

/// One recorded thing a partner did.
///
/// The input to the standing, and append-only in practice: a finding is superseded by a
/// `resolvedAt` rather than deleted, because "we looked into this and it was unfounded" is a
/// different fact from "this never happened", and a partner disputing a decertification is
/// entitled to the difference.
model PartnerConductFinding {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  partnerId String  @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  kind     PartnerFindingKind
  severity PartnerFindingSeverity

  /// What happened, for the person who will read it back to the partner.
  summary String

  /// Where it came from, in the observer's words. A scanner hit, a client call, a review of a
  /// co-branded page. A finding with no provenance is a rumour, and a standing built on rumours is
  /// how a commercial relationship ends on somebody's recollection.
  source String

  /// The client it concerned, when it concerned one. Null for a finding about the partner's own
  /// material rather than about a referral.
  clientId String? @db.Uuid

  occurredAt DateTime
  recordedAt DateTime @default(now())
  recordedBy String   @db.Uuid

  /// Set when somebody investigated and closed it. A resolved finding stops counting toward the
  /// standing and stays on the record.
  resolvedAt      DateTime?
  resolvedBy      String?   @db.Uuid
  /// Required to resolve. Whether it was upheld or dismissed, and why.
  resolutionNote  String?
  /// Whether the investigation agreed with the finding. Null while open. A dismissed finding is
  /// NOT deleted: a pattern of dismissed complaints about one partner is itself a signal, and it
  /// is invisible if dismissal erases the row.
  upheld Boolean?

  @@index([tenantId, partnerId, resolvedAt])
  @@index([tenantId, kind, occurredAt])
  @@map("partner_conduct_findings")
  @@schema("partners")
}

// ---------------------------------------------------------------------------
// 6.3 Client Conduct Monitoring
//
// The detection layer for client-generated risk. It detects; 6.4 decides.
//
// The interesting decision in this module is which way STALENESS moves, and
// the answer is not the same for every kind - which is the point ADR-0013
// makes and the reason it says a third cadenced record has to decide
// explicitly rather than copy a neighbour.
//
// A client who applied for capital behind our back while frozen, unreviewed
// for ninety days, is still a client who did that: the pause HARDENS, because
// nothing about the passage of time resolves it.
//
// A client who stopped answering the phone after funding, unreviewed for
// ninety days, may be in trouble. Freezing service to somebody in distress is
// the harm, not the remedy, so that one SOFTENS - toward outreach and a human,
// not toward a stricter gate.
//
// The direction is therefore a property of the kind, declared in code beside
// the kind, rather than a single rule applied to the table. See ADR-0044.
// ---------------------------------------------------------------------------

/// Blueprint 6.3's data model, as an enum.
///
/// Nine kinds, and they are not interchangeable: each one has its own staleness direction and its
/// own response, so a free-text `kind` would make both unqueryable and would let a tenth kind
/// arrive with no decision made about either.
enum ConductBreachKind {
  /// The client applied for capital elsewhere while placement was frozen.
  independent_application
  /// Debt found that the client did not disclose.
  undisclosed_debt
  /// Funds used for something other than what the placement was built around.
  funds_usage_anomaly
  /// Submitted documents that do not agree with each other or with a feed.
  document_inconsistency
  /// No response to a payment alert.
  payment_alert_non_response
  /// The client pressured staff or an agent to do something they should not.
  staff_pressure_incident
  /// No contact since funding.
  post_funding_non_response
  /// A fee dispute the record does not support.
  unfounded_fee_dispute
  /// Abusive conduct toward staff.
  abuse

  @@schema("risk")
}

/// One detected breach.
///
/// Resolved rather than deleted, like 6.4's listings, 7.5's holds and 8.4's findings: "we looked
/// into this and it was unfounded" is a different fact from "this never happened", and a client
/// disputing a termination is entitled to the difference.
model ClientConductBreach {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  clientId String @db.Uuid

  kind     ConductBreachKind
  /// Reuses 6.5's severity vocabulary, held as text and validated in code against SEVERITIES -
  /// the same arrangement 8.1 uses for partner tracks, and for the same reason: a fifth severity
  /// would be a decision, not a migration.
  severity String

  /// What happened, for the person who will read it back to the client.
  summary String

  /// Where the detection came from, in the observer's words. A breach with no provenance is an
  /// accusation, and a service pause built on accusations is how a client is cut off on a rumour.
  source String

  occurredAt DateTime
  detectedAt DateTime @default(now())
  detectedBy String   @db.Uuid

  /// How long before this breach is due for another look. Defaulted per kind in code rather than
  /// here, because the cadence and the staleness direction are one decision and splitting them
  /// across two files is how they drift apart.
  reviewCadenceDays Int
  lastReviewedAt    DateTime?
  lastReviewedBy    String?   @db.Uuid

  resolvedAt     DateTime?
  resolvedBy     String?   @db.Uuid
  /// Required to resolve. What was looked into and what was concluded.
  resolutionNote String?
  /// Whether the investigation agreed. Null while open. A dismissed breach is NOT deleted: a run
  /// of dismissed detections against one client is a signal about the detector.
  upheld Boolean?

  /// The 6.5 observation this breach produced, so the timeline and the breach record cannot
  /// disagree about whether something was recorded.
  observationId String? @db.Uuid

  @@index([tenantId, clientId, resolvedAt])
  @@index([tenantId, kind, occurredAt])
  @@map("client_conduct_breaches")
  @@schema("risk")
}

// ---------------------------------------------------------------------------
// 11.5 Vendor Activation Governance - ADR-0065
//
// One block, added by the launch-readiness slice. Firm-wide rather than per-tenant:
// the firm signs one DPA with Plaid, and a SOC 2 report is about the vendor, not
// about a tenant of ours.
// ---------------------------------------------------------------------------

/// The evidence a vendor gate requires before client financial data may leave this firm.
///
/// Specification v2 section 11.4 names three; vendor selection is the fourth because two
/// of the four vendors have no chosen counterparty yet, and there is nothing to review
/// the security of until somebody picks one.
enum VendorEvidenceKind {
  vendor_selection
  argus_security_review
  data_processing_agreement
  /// SOC 2 Type II, ISO 27001 or equivalent.
  security_attestation

  @@schema("admin")
}

/// One piece of evidence, accepted by a named Level 3 human on a date.
///
/// **`documentReference` is required and has no empty representation.** A row here without
/// one would be a tick-box that looks reviewed, which ADR-0065 argues is worse than the
/// compile-time constant it replaces - the constant at least left a commit.
///
/// Insert-only in practice: nothing supersedes or edits a row, and withdrawal writes
/// `withdrawnAt` rather than deleting, so "what did we rely on in March" survives.
model VendorEvidence {
  id String @id @default(uuid()) @db.Uuid

  /// A `VendorId`. Held as text and validated in code against VENDOR_IDS, so adding a
  /// vendor is a data change rather than a migration.
  vendor String
  kind   VendorEvidenceKind

  /// The document this rests on - a report number, an executed agreement reference, an
  /// attestation id. Required. There is no code path that writes an empty one.
  documentReference String

  /// Who issued the document. Not us, for three of the four kinds.
  issuedBy String
  issuedOn DateTime

  /// When the document stops being evidence. A SOC 2 Type II covers a stated period and
  /// does not describe the vendor afterwards. Null means the document does not expire,
  /// which is true of an executed DPA and false of an attestation.
  validUntil DateTime?

  /// The Level 3 human who accepted it. The level is read from THIS actor at acceptance,
  /// never from the caller - ADR-0009's rule.
  acceptedBy String   @db.Uuid
  acceptedAt DateTime

  /// The tenant the accepting actor belongs to. Carried so an audit can find the person.
  acceptedInTenantId String @db.Uuid

  /// Withdrawal is a compensating write, never a delete.
  withdrawnAt     DateTime?
  withdrawnBy     String?   @db.Uuid
  withdrawnReason String?

  createdAt DateTime @default(now())

  @@index([vendor, kind, withdrawnAt])
  @@map("vendor_evidence")
  @@schema("admin")
}
