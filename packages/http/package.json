{
  "name": "@bwc/http",
  "version": "0.1.0",
  "private": true,
  "description": "Outcome-to-HTTP serialization, shared by the internal API and the Client Portal.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bwc/core": "workspace:*",
    "@bwc/identity": "workspace:*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/express": "^5.0.0"
  }
}
