{
  "name": "burkham-wickmont-operations-console",
  "version": "0.1.0",
  "private": true,
  "description": "Burkham Wickmont Operations Console - the dedicated operating environment for the Burkham Wickmont Village",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:invariants": "vitest run tests/invariants",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --force --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "setup": "pnpm install && pnpm db:generate",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "dev:api": "pnpm --filter @bwc/api dev",
    "dev:worker": "pnpm --filter @bwc/worker dev",
    "worker": "pnpm --filter @bwc/worker start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "cron-parser": "^5.8.1"
  }
}
