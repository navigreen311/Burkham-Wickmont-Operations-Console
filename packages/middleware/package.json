{
  "name": "@bwc/middleware",
  "version": "0.1.0",
  "private": true,
  "description": "The fixed seven-step middleware chain (Specification v2 section 5.5).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bwc/core": "workspace:*",
    "@bwc/ledger": "workspace:*",
    "@bwc/identity": "workspace:*",
    "@bwc/tenancy": "workspace:*",
    "@bwc/clients": "workspace:*",
    "@bwc/firewall": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
