# Burkham Wickmont Operations Console - environment template
# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# Local development uses the native PostgreSQL 17 service.
DATABASE_URL="postgresql://YOUR_PG_USER:YOUR_PG_PASSWORD@127.0.0.1:5432/bwc_console_dev?schema=public"

# --- Event Ledger ---------------------------------------------------------
# HMAC key used to sign ledger entries. Rotate through a secret manager in any
# deployed environment; a signature is only as meaningful as the key's custody.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEDGER_SIGNING_KEY="YOUR_LEDGER_SIGNING_KEY_HERE"

# --- Secure Document Vault (3.2) ------------------------------------------
# Key-encryption key. Each document gets a random DEK; the DEK is wrapped by this
# KEK. Rotating the KEK re-wraps DEKs rather than re-encrypting every tax return.
# Specification v2 section 6.2 wants this in an HSM before production - the
# EnvKekProvider is a development seam, and KekProvider is where an HSM plugs in.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_KEK="YOUR_VAULT_KEK_HERE"
# Where encrypted blobs land. Ciphertext only - the store never receives plaintext.
VAULT_BLOB_ROOT="./.vault-blobs"

# --- API ------------------------------------------------------------------
API_PORT=4100
NODE_ENV=development

# --- Workflow Engine worker (module 2.2) ---------------------------------
# The worker writes ledger events, and principle 3 allows no anonymous state
# changes - so it acts as a real, resolvable actor rather than a synthetic
# "system" identity. Startup refuses if this does not resolve.
WORKER_ACTOR_ID="YOUR_WORKER_ACTOR_UUID_HERE"
WORKER_INTERVAL_MS=5000
WORKER_BATCH_SIZE=20
# Optional: restrict this worker to one tenant. Omit to process every tenant.
# WORKER_TENANT_ID=

# --- Integration Layer (11.5) --------------------------------------------
# All external calls route through the Integration Layer. Every vendor below is
# gated on Argus security review + signed DPA + SOC 2 Type II before any real
# credential is used (Specification v2 section 11.4). Until that gate clears,
# adapters run in stub mode and report not_built honestly rather than faking data.
INTEGRATION_MODE=stub   # stub | sandbox | live

# Decision A - Plaid is the V1 bank statement source
PLAID_CLIENT_ID="YOUR_PLAID_CLIENT_ID_HERE"
PLAID_SECRET="YOUR_PLAID_SECRET_HERE"
PLAID_ENV=sandbox

# Decision B - business bureau (vendor selection pending: Nav / Experian / D&B)
BUSINESS_BUREAU_API_KEY="YOUR_BUSINESS_BUREAU_API_KEY_HERE"

# Decision B - personal credit (vendor selection pending: Array or equivalent)
PERSONAL_CREDIT_API_KEY="YOUR_PERSONAL_CREDIT_API_KEY_HERE"

# CapitalForge - the Console calls it, never reimplements it
CAPITALFORGE_BASE_URL="http://127.0.0.1:4000"
CAPITALFORGE_API_KEY="YOUR_CAPITALFORGE_API_KEY_HERE"
